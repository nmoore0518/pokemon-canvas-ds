{
  "key": 18187,
  "messages": [
    {
      "id": "msg_0519_T09_CinnabarIsland_Text_BlaineLivedHereSinceBeforeLab",
      "en_US": [
        "Cinnabar Gym’s Blaine is quite the\n",
        "odd fellow.\r",
        "He’s lived on the island since way\n",
        "before the Lab was built."
      ]
    },
    {
      "id": "msg_0519_T09_CinnabarIsland_Text_ScientistsExperimentInMansion",
      "en_US": [
        "Scientists conduct experiments \n",
        "in the burned-out building.\r",
        "You know, the one they call the\n",
        "Pokémon Mansion."
      ]
    },
    {
      "id": "msg_0519_T09_CinnabarIsland_Text_IslandSign",
      "en_US": [
        "Cinnabar Island\n",
        "The Fiery Town of Burning Desire"
      ]
    },
    {
      "id": "msg_0519_T09_CinnabarIsland_Text_PokemonLab",
      "en_US": "Pokémon Lab"
    },
    {
      "id": "msg_0519_T09_CinnabarIsland_Text_GymSign",
      "en_US": [
        "Cinnabar Island Pokémon Gym\n",
        "Leader: Blaine\f",
        "The Hotheaded Quiz Master!"
      ]
    },
    {
      "id": "msg_0519_T09_CinnabarIsland_Text_DoorIsLocked",
      "en_US": "The door is locked…"
    },
    {
      "id": "msg_0519_T09_CinnabarIsland_Text_HeyIfItIsntPlayer",
      "en_US": [
        "Huh?\n",
        "Hey, if it isn’t {STRVAR_1 3, 6, 0}!"
      ]
    },
    {
      "id": "msg_0519_T09_CinnabarIsland_Text_ComeWithMeToOneIsland",
      "en_US": [
        "Look, it’s me, Bill.\n",
        "Long time no see!\r",
        "I hope you’re still using my\n",
        "PC system.\r",
        "Well, listen, since we met up here,\n",
        "how about spending time with me?\r",
        "There’s this little island in the far\n",
        "south called One Island.\r",
        "A friend invited me, so I’m on my\n",
        "way out there.\r",
        "How about it?\n",
        "Do you feel like coming with me?"
      ]
    },
    {
      "id": "msg_0519_T09_CinnabarIsland_Text_IfYouHaveTriPassYouCanGoAgain",
      "en_US": [
        "Hey, wasn’t that a long cruise?\r",
        "My buddy Celio seemed to enjoy\n",
        "your company.\r",
        "I’m sure he’d welcome you if you\n",
        "were to visit him again.\r",
        "If you have a Tri-Pass, you can\n",
        "always take a ferry there from\f",
        "Vermilion Port.\r",
        "All right, thanks for your company!"
      ]
    },
    {
      "id": "msg_0519_T09_CinnabarIsland_Text_MyPalsBoatArrived",
      "en_US": [
        "Looks like my pal’s boat arrived,\n",
        "too.\r",
        "He sent it specially here to\n",
        "Cinnabar to pick me up."
      ]
    },
    {
      "id": "msg_0519_T09_CinnabarIsland_Text_AllRightLetsGo",
      "en_US": [
        "All right, then.\n",
        "Let’s go!"
      ]
    },
    {
      "id": "msg_0519_T09_CinnabarIsland_Text_IllBeWaitingInPokeCenter",
      "en_US": [
        "What, are you too busy?\r",
        "Well, all right.\n",
        "The boat hasn’t arrived yet anyway.\r",
        "I’ll be waiting at the Pokémon\n",
        "Center over there.\r",
        "Come see me when you’re done with\n",
        "your business here."
      ]
    },
    {
      "id": "msg_0519_T09_TypeTutor_Text_WhichMove",
      "en_US": "Which move should I teach?"
    },
    {
      "id": "msg_0519_T09_TypeTutor_Text_WhichMon",
      "en_US": [
        "Which Pokémon should learn\n",
        "{STRVAR_1 3, 0, 0}?"
      ]
    },
    {
      "id": "msg_0519_T09_TypeTutor_Text_Taught",
      "en_US": "Well done! Anything else?"
    },
    {
      "id": "msg_0519_T09_TypeTutor_Text_Bye",
      "en_US": [
        "Come back any time. A Leader\n",
        "never stops learning."
      ]
    },
    {
      "id": "msg_0519_T09_cv_unported",
      "en_US": [
        "(Canvas DS: this part of the game\n",
        "isn’t ported yet.)"
      ]
    }
  ]
}
