    {
      "id": "msg_0937_CV_CANVAS_CINNABAR_LAB_EXPERIMENTROOM_Trade_Text_LookingForMonWannaTradeForMon",
      "en_US": [
        "I’m looking for the Pokémon\n",
        "{STRVAR_1 3, 0, 0}!\r",
        "Wanna trade one for my\n",
        "{STRVAR_1 3, 1, 0}?"
      ]
    },
    {
      "id": "msg_0937_CV_CANVAS_CINNABAR_LAB_EXPERIMENTROOM_Trade_Text_HeyThanks",
      "en_US": "Hey, thanks!"
    },
    {
      "id": "msg_0937_CV_CANVAS_CINNABAR_LAB_EXPERIMENTROOM_CinnabarIsland_PokemonLab_ExperimentRoom_Text_HaveYouAFossilForMe",
      "en_US": [
        "Hiya!\r",
        "I am important doctor.\n",
        "Yes, very much so, indeed.\r",
        "Here, I study rare Pokémon fossils.\n",
        "All the time, I study.\r",
        "You!\n",
        "Have you a fossil for me?"
      ]
    },
    {
      "id": "msg_0937_CV_CANVAS_CINNABAR_LAB_EXPERIMENTROOM_CinnabarIsland_PokemonLab_ExperimentRoom_Text_ThatFossilIsOfMonMakeItLiveAgain",
      "en_US": [
        "Oh!\n",
        "That is {STRVAR_1 3, 1, 0}, it is!\r",
        "It is fossil of {STRVAR_1 3, 0, 0},\n",
        "a Pokémon that is already extinct!\r",
        "My Resurrection Machine will make\n",
        "that Pokémon live again!"
      ]
    },
    {
      "id": "msg_0937_CV_CANVAS_CINNABAR_LAB_EXPERIMENTROOM_CinnabarIsland_PokemonLab_ExperimentRoom_Text_HandedFossilToWeirdDoctor",
      "en_US": [
        "So!\n",
        "You hurry and give me that!\r",
        "{STRVAR_1 3, 6, 0} handed over the\n",
        "{STRVAR_1 3, 1, 0} to the weird doctor."
      ]
    },
    {
      "id": "msg_0937_CV_CANVAS_CINNABAR_LAB_EXPERIMENTROOM_CinnabarIsland_PokemonLab_ExperimentRoom_Text_TakesTimeGoForWalk",
