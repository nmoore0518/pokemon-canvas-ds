    {
      "id": "msg_0451_T01R0301_GymSwitch_Text_LabSwitchBack",
      "en_US": [
        "Oak: Ah, {STRVAR_1 3, 6, 0}! Would you like\n",
        "your Gym to go back to a type\f",
        "it’s had before? It’s free!"
      ]
    },
    {
      "id": "msg_0451_T01R0301_PokedexRating_Text_ThankYouMadeDreamReality",
      "en_US": [
        "Thank you, {STRVAR_1 3, 6, 0}!\n",
        "Sincerely, thank you!\f",
        "You’ve made my dream a reality!"
      ]
    },
    {
      "id": "msg_0451_T01R0301_PalletTown_ProfessorOaksLab_Text_OakMonsAroundWorldWait",
      "en_US": [
        "Pokémon around the world wait for\n",
        "you, {STRVAR_1 3, 6, 0}!"
      ]
    },
    {
      "id": "msg_0451_T01R0301_PalletTown_ProfessorOaksLab_Text_OakFavorToAskYouPlayer",
      "en_US": [
        "Ah, now this is excellent!\r",
        "{STRVAR_1 3, 6, 0}, I have another important\n",
        "favor to ask of you.\r",
        "I need you to listen closely."
      ]
    },
    {
      "id": "msg_0451_T01R0301_Text_OakMissedBalloon",
      "en_US": [
        "Oak: Ah, {STRVAR_1 3, 6, 0}! I nearly forgot.\r",
        "Take this Hot Air Balloon. It will\n",
        "float you to any town you’ve\f",
        "visited, even back to your Gym!"
      ]
    },
    {
      "id": "msg_0451_T01R0301_GymCandidate_Text_OakAside4",
      "en_US": [
        "Oak: Nearly every Leader approves\n",
        "of you.\r",
        "The League will be very pleased.\n",
        "…Yes. Very pleased."
      ]
    },
    {
      "id": "msg_0451_T01R0301_PalletTown_ProfessorOaksLab_Text_OakHaveSomethingForMe",
      "en_US": [
        "Oak: Oh, {STRVAR_1 3, 6, 0}!\n",
        "How is my old Pokémon?\r",
        "Well, it seems to be growing more\n",
        "attached to you.\r",
        "You must be talented as a Pokémon\n",
        "Trainer.\r",
        "What’s that?\n",
        "You have something for me?"
      ]
    },
    {
      "id": "msg_0451_T01R0301_PalletTown_ProfessorOaksLab_Text_DeliveredOaksParcel",
      "en_US": "{STRVAR_1 3, 6, 0} delivered Oak’s Parcel."
    },
