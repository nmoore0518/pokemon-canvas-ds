    {
      "id": "msg_0962_CV_CANVAS_PEWTER_PAINTER_LOFT_PainterLoft_Text_Fairy",
      "en_US": "Fairy"
    },
    {
      "id": "msg_0962_CV_CANVAS_PEWTER_PAINTER_LOFT_PainterLoft_Text_WhichSlot",
      "en_US": [
        "Which move should Quick Sketch be\n",
        "painted over?"
      ]
    },
    {
      "id": "msg_0962_CV_CANVAS_PEWTER_PAINTER_LOFT_PainterLoft_Text_ConfirmSlot",
      "en_US": [
        "Quick Sketch goes over {STRVAR_1 3, 0, 0}’s\n",
        "{STRVAR_1 3, 1, 0}. If it doesn’t keep a\f",
        "new move, {STRVAR_1 3, 1, 0} comes back.\f",
        "All right?"
      ]
    },
    {
      "id": "msg_0962_CV_CANVAS_PEWTER_PAINTER_LOFT_PainterLoft_Text_MegaGo",
      "en_US": [
        "It’s on the easel. Take Smeargle.\n",
        "It should see this."
      ]
    },
    {
      "id": "msg_0962_CV_CANVAS_PEWTER_PAINTER_LOFT_PainterLoft_Text_GiftNoRoom",
      "en_US": [
        "Oh, there’s no room at all. Make\n",
        "some, and I’ll have it ready."
      ]
    },
    {
      "id": "msg_0962_CV_CANVAS_PEWTER_PAINTER_LOFT_PainterLoft_Text_GiftToPC",
      "en_US": "Smeargle was sent to the PC."
    },
    {
      "id": "msg_0962_CV_CANVAS_PEWTER_PAINTER_LOFT_PainterLoft_Text_SketchGo",
      "en_US": [
        "Done. The canvas is on the easel.\n",
        "Use Quick Sketch on the figure and\f",
        "pick whichever of its moves you like."
      ]
    },
    {
      "id": "msg_0962_CV_CANVAS_PEWTER_PAINTER_LOFT_cv_unported",
      "en_US": [
        "(Canvas DS: this part of the game\n",
        "isn’t ported yet.)"
      ]
    }
  ]
}
