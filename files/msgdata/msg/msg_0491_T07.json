  "messages": [
    {
      "id": "msg_0491_T07_CeladonCity_Text_KeepOutOfTeamRocketsWay",
      "en_US": "Keep out of Team Rocket’s way!"
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_MyTrustedPalPoliwrath",
      "en_US": [
        "This is my trusted pal, Poliwrath.\r",
        "It evolved from a Poliwhirl when\n",
        "I used a Water Stone."
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_Poliwrath",
      "en_US": "Poliwrath: Ribi ribit!"
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_GotMyKoffingInCinnabar",
      "en_US": [
        "I got my Koffing in Cinnabar.\r",
        "It’s usually nice, but it breathes\n",
        "poison when it’s angry."
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_GameCornerIsBadForCitysImage",
      "en_US": [
        "Celadon takes pride in its efforts\n",
        "to keep the city beautiful.\r",
        "That’s why the new Game Corner is\n",
        "bad for our city’s image."
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_BlewItAllAtSlots",
      "en_US": [
        "Moan…\n",
        "I blew it all at the slots!\r",
        "I knew I should have cashed in my\n",
        "Coins for prizes!"
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_GetLostOrIllPunchYou",
      "en_US": [
        "What are you staring at?\n",
        "Get lost, or I’ll punch you."
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_GymIsGreatFullOfWomen",
      "en_US": [
        "Heheh! This Gym is great!\n",
        "It’s full of women!"
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_ScaldedTongueOnTea",
      "en_US": [
        "Aaaagh, ow…\n",
        "I scalded my tongue!\r",
        "This nice old lady in the Mansion\n",
        "gave me some Tea.\r",
        "But it was boiling hot!\n",
        "Gotta cool it to drink it."
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_SomeoneStoleSilphScope",
      "en_US": [
        "Oh, what am I to do…\r",
        "Someone stole our Silph Scope.\r",
        "The thief came running this way,\n",
        "I’m sure of it.\r",
        "But I lost sight of him!\n",
        "Where’d he go?"
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_GuardSpecProtectsFromStatus",
      "en_US": [
        "Trainer Tips\r",
        "Guard Spec. protects Pokémon\n",
        "from status-reduction moves during\f",
        "battle.\r",
        "Get your items at the\n",
        "Celadon Dept. Store!"
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_PrizeExchangeSign",
      "en_US": [
        "Coins exchanged for prizes!\n",
        "Prize Exchange"
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_GameCornerSign",
      "en_US": [
        "Rocket Game Corner\n",
        "The playground for grown-ups!"
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_CitySign",
      "en_US": [
        "Celadon City\n",
        "The City of Rainbow Dreams"
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_MansionSign",
      "en_US": "Celadon Mansion"
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_ExplainXAccuracyDireHit",
      "en_US": [
        "Trainer Tips\r",
        "X Accuracy boosts the accuracy of\n",
        "techniques.\r",
        "Dire Hit jacks up the likelihood\n",
        "of critical hits.\r",
        "Get your items at the Celadon\n",
        "Dept. Store!"
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_DeptStoreSign",
      "en_US": [
        "Find what you need at the\n",
        "Celadon Dept. Store!"
      ]
    },
    {
      "id": "msg_0491_T07_CeladonCity_Text_GymSign",
      "en_US": [
        "Celadon City Pokémon Gym\n",
        "Leader: Erika\f",
        "The Nature-Loving Princess!"
      ]
    },
    {
      "id": "msg_0491_T07_Route7_Text_UndergroundPathSign",
      "en_US": [
        "Underground Path\n",
        "Celadon City - Lavender Town"
      ]
    },
    {
      "id": "msg_0491_T07_Text_SoftboiledTutor_Retired",
      "en_US": [
        "I used to teach Soft-Boiled.\n",
        "The Leader Academy’s masters\r",
        "teach it now. Look for the\n",
        "Normal master in Pewter\r",
        "City."
      ]
    },
    {
