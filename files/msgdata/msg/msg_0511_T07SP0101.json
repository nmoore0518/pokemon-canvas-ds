  "messages": [
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_CanExchangeCoinsNextDoor",
      "en_US": [
        "Welcome!\r",
        "You can exchange your Coins for\n",
        "fabulous prizes next door."
      ]
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_WelcomeBuySomeCoins",
      "en_US": [
        "Welcome to Rocket Game Corner!\r",
        "Do you need some game Coins?\n",
        "Would you like to buy some?"
      ]
    },
    {
      "id": "msg_0511_T07SP0101_cv_mc_game_corner_coin_purchase_counter_0",
      "en_US": " 50 Coins  ¥1,000"
    },
    {
      "id": "msg_0511_T07SP0101_cv_mc_game_corner_coin_purchase_counter_1",
      "en_US": "500 Coins  ¥10,000"
    },
    {
      "id": "msg_0511_T07SP0101_cv_mc_game_corner_coin_purchase_counter_2",
      "en_US": "Exit"
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_RumoredTeamRocketRunsThisPlace",
      "en_US": [
        "Keep this quiet.\r",
        "It’s rumored that this place is run\n",
        "by Team Rocket."
      ]
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_ThinkMachinesHaveDifferentOdds",
      "en_US": [
        "I think these machines have\n",
        "different odds."
      ]
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_DoYouWantToPlay",
      "en_US": "Kid, do you want to play?"
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_Received10CoinsFromMan",
      "en_US": [
        "{STRVAR_1 3, 6, 0} received 10 Coins\n",
        "from the man."
      ]
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_GymGuyAdvice",
      "en_US": [
        "Hey!\r",
        "You have better things to do,\n",
        "champ in the making!\r",
        "Celadon Gym’s Leader is Erika.\r",
        "She is a user of Grass-type\n",
        "Pokémon, and at one with nature.\r",
        "She might appear docile because of\n",
        "her flower arranging…\r",
        "But she’s not one to be taken\n",
        "lightly!"
      ]
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_WinOrLoseItsOnlyLuck",
      "en_US": [
        "These slot games…\n",
        "Win or lose, it’s only by luck."
      ]
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_SoEasyToGetHooked",
      "en_US": [
        "Games are scary!\n",
        "It’s so easy to get hooked!"
      ]
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_WantSomeCoins",
      "en_US": [
        "What’s up?\n",
        "Want some Coins?"
      ]
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_Received20CoinsFromNiceGuy",
      "en_US": [
        "{STRVAR_1 3, 6, 0} received 20 Coins\n",
        "from the nice guy."
      ]
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_HereAreSomeCoinsShoo",
      "en_US": [
        "Hey, what? You’re throwing me off!\n",
        "Here are some Coins, so shoo!"
      ]
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_Received20CoinsFromMan",
      "en_US": [
        "{STRVAR_1 3, 6, 0} received 20 Coins\n",
        "from the man."
      ]
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_GruntIntro",
      "en_US": [
        "I’m guarding this poster!\n",
        "Go away, or else!"
      ]
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_GruntPostBattle",
      "en_US": [
        "The Team Rocket Hideout might\n",
        "be discovered!\r",
        "Wait, you’re that inventor from\n",
        "Pallet Town!\r",
        "Oh, wait… never mind.\r",
        "I better tell Boss!"
      ]
    },
    {
      "id": "msg_0511_T07SP0101_Pit_Text_Overheard",
      "en_US": [
        "(The man is whispering to his\n",
        "friend…)\r",
        "…changed it again. Word this week\n",
        "is Gravel.\r",
        "Same place. The wall past the prize\n",
        "shop, the building with no door.\f",
        "Just walk right into it."
      ]
    },
    {
      "id": "msg_0511_T07SP0101_Pit_Text_WhispererCaught",
      "en_US": [
        "Huh? Were you listening?\r",
        "…I was talking about my garden.\n",
        "Gravel. For the path. Get lost."
      ]
    },
    {
      "id": "msg_0511_T07SP0101_Pit_Text_ListenerBeatIt",
      "en_US": [
        "Beat it, kid. Grown-up\n",
        "conversation."
      ]
    },
    {
      "id": "msg_0511_T07SP0101_CeladonCity_GameCorner_Text_OutOfOrder",
      "en_US": [
        "out of Order\n",
        "This is broken."
