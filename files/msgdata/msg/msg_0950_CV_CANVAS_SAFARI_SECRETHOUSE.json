  "messages": [
    {
      "id": "msg_0950_CV_CANVAS_SAFARI_SECRETHOUSE_SafariZone_SecretHouse_Text_CongratsYouveWon",
      "en_US": [
        "Ah! Finally!\r",
        "You’re the first person to reach\n",
        "the Secret House!\r",
        "Although I made a campaign\n",
        "for our grand opening,\r",
        "I was getting worried that no one\n",
        "would win our campaign prize.\r",
        "Congratulations!\n",
        "You have won!"
      ]
    },
    {
      "id": "msg_0950_CV_CANVAS_SAFARI_SECRETHOUSE_SafariZone_SecretHouse_Text_ReceivedHM03FromAttendant",
      "en_US": [
        "{STRVAR_1 3, 6, 0} received HM03\n",
        "from the attendant!"
      ]
    },
    {
      "id": "msg_0950_CV_CANVAS_SAFARI_SECRETHOUSE_Text_GymHack_AndTakeThisToo",
      "en_US": [
        "Oh, and take this, too!\r",
        "It does the same job outside of\n",
        "battle, no Pokémon needed."
      ]
    },
    {
      "id": "msg_0950_CV_CANVAS_SAFARI_SECRETHOUSE_SafariZone_SecretHouse_Text_ExplainSurf",
      "en_US": [
        "HM03 is Surf.\r",
        "Pokémon will be able to ferry you\n",
        "across water using it.\r",
        "And, this HM isn’t disposable, so\n",
        "you can use it over and over.\r",
        "You’re super lucky for winning this\n",
        "fabulous prize!"
      ]
    },
    {
      "id": "msg_0950_CV_CANVAS_SAFARI_SECRETHOUSE_SafariZone_SecretHouse_Text_DontHaveRoomForPrize",
      "en_US": [
        "You don’t have room for this\n",
        "fabulous prize!"
      ]
    },
    {
      "id": "msg_0950_CV_CANVAS_SAFARI_SECRETHOUSE_cv_unported",
      "en_US": [
        "(Canvas DS: this part of the game\n",
        "isn’t ported yet.)"
      ]
    }
  ]
