{
  "key": 17434,
  "messages": [
    {
      "id": "msg_0499_T07R0106_CeladonCity_DepartmentStore_Roof_Text_MySisterIsImmature",
      "en_US": [
        "My sister is a Trainer, believe it\n",
        "or not.\r",
        "But, she’s so immature, she drives\n",
        "me nuts!"
      ]
    },
    {
      "id": "msg_0499_T07R0106_CeladonCity_DepartmentStore_Roof_Text_FloorSign",
      "en_US": [
        "Rooftop Square:\n",
        "Vending Machines"
      ]
    },
    {
      "id": "msg_0499_T07R0106_CeladonCity_DepartmentStore_Roof_Text_VendingMachineWhatDoesItHave",
      "en_US": [
        "A vending machine!\n",
        "What does it have?"
      ]
    },
    {
      "id": "msg_0499_T07R0106_CeladonCity_DepartmentStore_Roof_Text_ComeBackWhenMastered",
      "en_US": [
        "Every time you master a new type,\n",
        "come see me! I’ll have another\f",
        "Limited Edition Soda for you!"
      ]
    },
    {
      "id": "msg_0499_T07R0106_CeladonCity_DepartmentStore_Roof_Text_ImThirstyIWantDrink",
      "en_US": [
        "My drink got stuck in the vending\n",
        "machine! And now I’m so thirsty!\r",
        "I want a Fresh Water, a Soda Pop\n",
        "and a Lemonade!"
      ]
    },
    {
      "id": "msg_0499_T07R0106_CeladonCity_DepartmentStore_Roof_Text_ImThirstyGiveHerDrink",
      "en_US": [
        "My drink got stuck in the vending\n",
        "machine! And now I’m so thirsty!\r",
        "Give her a drink?"
      ]
    },
    {
      "id": "msg_0499_T07R0106_CeladonCity_DepartmentStore_Roof_Text_GiveWhichDrink",
      "en_US": "Give her which drink?"
    },
    {
      "id": "msg_0499_T07R0106_cv_mc_celadon_vending_machine_0",
      "en_US": "Fresh Water  ¥200"
    },
    {
      "id": "msg_0499_T07R0106_cv_mc_celadon_vending_machine_1",
      "en_US": "Soda Pop  ¥300"
    },
    {
      "id": "msg_0499_T07R0106_cv_mc_celadon_vending_machine_2",
      "en_US": "Lemonade  ¥350"
    },
    {
      "id": "msg_0499_T07R0106_cv_mc_celadon_vending_machine_3",
      "en_US": "Exit"
