    {
      "id": "msg_0868_CV_SAFFRON_FIGHTING_DOJO_SaffronCity_Dojo_Text_HitoshiIntro",
      "en_US": [
        "Hwaah!\r",
        "You’re trespassing in our\n",
        "Fighting Dojo!"
      ]
    },
    {
      "id": "msg_0868_CV_SAFFRON_FIGHTING_DOJO_SaffronCity_Dojo_Text_HitoshiPostBattle",
      "en_US": [
        "The prime fighters across the land\n",
        "train here."
      ]
    },
    {
      "id": "msg_0868_CV_SAFFRON_FIGHTING_DOJO_SaffronCity_Dojo_Text_MasterKoichiIntro",
      "en_US": [
        "Grunt!\r",
        "I am the Karate Master!\n",
        "I am the Leader here!\r",
        "You wish to challenge us?\n",
        "Expect no mercy!\r",
        "Fwaaa!"
      ]
    },
    {
      "id": "msg_0868_CV_SAFFRON_FIGHTING_DOJO_SaffronCity_Dojo_Text_ChoosePrizedFightingMon",
      "en_US": [
        "Indeed, I have lost!\r",
        "But, I beseech you, do not take\n",
        "our emblem as your trophy!\r",
        "In return, I will give you a prized\n",
        "Fighting Pokémon!\r",
        "Choose whichever one you like!"
      ]
    },
    {
      "id": "msg_0868_CV_SAFFRON_FIGHTING_DOJO_SaffronCity_Dojo_Text_YouWantHitmonlee",
      "en_US": [
        "You want the hard-kicking\n",
        "Hitmonlee?"
      ]
    },
    {
      "id": "msg_0868_CV_SAFFRON_FIGHTING_DOJO_SaffronCity_Dojo_Text_YouWantHitmonchan",
      "en_US": [
