      "en_US": [
        "Welcome.\r",
        "The President is in the boardroom\n",
        "on 11F."
      ]
    },
    {
      "id": "msg_0537_T11R0701_PaintWorld_Text_FigureFirst",
      "en_US": [
        "… … …\r",
        "A figure made of paint turns to\n",
        "face you. It raises a brush."
      ]
    },
    {
      "id": "msg_0537_T11R0701_SilphCo_1F_Text_FloorSign",
      "en_US": [
        "Silph Co. Head Office\n",
        "1F"
      ]
    },
    {
      "id": "msg_0537_T11R0701_PaintWorld_Text_FigureSketch",
      "en_US": [
