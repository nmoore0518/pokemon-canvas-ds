{
  "key": 20247,
  "messages": [
    {
      "id": "msg_0360_R22_Route22_Text_LeagueGateSign",
      "en_US": [
        "Pokémon League\n",
        "Front Gate"
      ]
    },
    {
      "id": "msg_0360_R22_Text_DreamEaterTutor_Retired",
      "en_US": [
        "I used to teach Dream Eater.\n",
        "The Leader Academy’s masters\r",
        "teach it now. Look for the\n",
        "Psychic master in Saffron\r",
        "City."
      ]
    },
    {
      "id": "msg_0360_R22_Route22_Text_EarlyRivalIntro",
      "en_US": [
        "{STRVAR_1 3, 7, 0}: Hey! {STRVAR_1 3, 6, 0}!\r",
        "You’re off to the Pokémon League?\n",
        "Forget about it!\r",
        "You probably don’t have any\n",
        "Badges, do you?\r",
        "The guard won’t let you through\n",
        "without them.\r",
        "By the way, did your Pokémon get\n",
        "any stronger?"
      ]
    },
    {
      "id": "msg_0360_R22_Route22_Text_EarlyRivalPostBattle",
      "en_US": [
        "I heard the Pokémon League is\n",
        "crawling with tough Trainers.\r",
        "I have to figure out how to get\n",
        "past them.\r",
        "You should quit dawdling and get a\n",
        "move on!\r",
        "And forget about the Pallet Gym.\n",
        "That one’s Mine!"
      ]
    },
    {
      "id": "msg_0360_R22_Route22_Text_LateRivalIntro",
      "en_US": [
        "{STRVAR_1 3, 7, 0}: What? {STRVAR_1 3, 6, 0}!\n",
        "What a surprise to see you here!\r",
        "So you’re going to the Pokémon\n",
        "League?\r",
        "You collected all the Badges, too?\n",
        "And all the approvals? That’s cool!\r",
        "But only one of us gets the Pallet\n",
        "Gym.\r",
        "Then I’ll whip you, {STRVAR_1 3, 6, 0}, as a\n",
        "warm-up for the Pokémon League!\r",
        "Come on!"
      ]
    },
    {
      "id": "msg_0360_R22_Route22_Text_LateRivalPostBattle",
      "en_US": [
        "That loosened me up.\n",
        "I’m ready for the Pokémon League!\r",
        "{STRVAR_1 3, 6, 0}, you need more practice.\r",
        "Only one of us is coming home as\n",
        "a Leader. And it’s gonna be me!\r",
        "I’m out of here. Smell ya!"
      ]
    },
    {
      "id": "msg_0360_R22_Text_GymHack_WrongType",
      "en_US": [
        "League Rules: Only {STRVAR_1 3, 2, 0}-type\n",
        "Pokémon may be on your team.\r",
        "{STRVAR_1 3, 0, 0} is {STRVAR_1 3, 1, 0}-type!\r",
        "Leave it in a PC and come back."
      ]
    },
    {
      "id": "msg_0360_R22_Text_GymHack_Duplicate",
      "en_US": [
        "League Rules: No two Pokémon on\n",
        "your team may be the same species.\r",
        "You have more than one\n",
        "{STRVAR_1 3, 0, 0}!\r",
        "Leave one in a PC and come back."
      ]
    },
    {
      "id": "msg_0360_R22_Text_GymHack_DuplicateItem",
      "en_US": [
        "League Rules: No two Pokémon on\n",
        "your team may hold the same item.\r",
        "More than one is holding\n",
        "{STRVAR_1 3, 0, 0}!\r",
        "Take one off and come back."
      ]
    },
    {
      "id": "msg_0360_R22_cv_unported",
      "en_US": [
        "(Canvas DS: this part of the game\n",
        "isn’t ported yet.)"
      ]
    }
  ]
}
