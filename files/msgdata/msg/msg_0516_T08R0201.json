  "messages": [
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_FirstTimeAtSafariZone",
      "en_US": [
        "Hi! Is it your first time here at\n",
        "the Safari Zone?"
      ]
    },
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_SorryYoureARegularHere",
      "en_US": "Sorry, you’re a regular here!"
    },
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_CatchFairShareComeAgain",
      "en_US": [
        "Did you catch your fair share?\n",
        "Come again!"
      ]
    },
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_GoingToLeaveSafariZoneEarly",
      "en_US": [
        "Are you going to leave the\n",
        "Safari Zone early?"
      ]
    },
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_PleaseReturnSafariBalls",
      "en_US": [
        "Please return any Safari Balls\n",
        "you may have left."
      ]
    },
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_ExplainSafariZone",
      "en_US": [
        "The Safari Zone actually has\n",
        "four zones in it.\r",
        "Each zone has different kinds of\n",
        "Pokémon, even some rare ones.\r",
        "Use the supplied Safari Balls to\n",
        "catch them.\r",
        "You can also throw Bait or Rocks\n",
        "besides the Safari Balls.\r",
        "If you throw Bait, the Pokémon\n",
        "becomes less likely to flee, but\f",
        "harder to catch.\r",
        "If you throw Rocks, the Pokémon\n",
        "becomes more likely to flee, but\f",
        "easier to catch.\r",
        "When you run out of time or Safari\n",
        "Balls, it’s game over for you!"
      ]
    },
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_WelcomeToSafariZone",
      "en_US": "Welcome to the Safari Zone!"
    },
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_PlaySafariGameFor500",
      "en_US": [
        "For just ¥500, you can play the\n",
        "Safari Game.\r",
        "You can roam the wide-open safari\n",
        "and catch what you like.\r",
        "Would you like to play?"
      ]
    },
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_OkayPleaseComeAgain",
      "en_US": [
        "Okay.\n",
        "Please come again!"
      ]
    },
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_GoodLuck",
      "en_US": "Good luck!"
    },
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_ThatllBe500WeOnlyUseSpecialBalls",
      "en_US": [
        "That’ll be ¥500, please!\r",
        "We only use a special kind of \n",
        "Poké Balls here."
      ]
    },
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_PlayerReceived30SafariBalls",
      "en_US": [
        "{STRVAR_1 3, 6, 0} received 30 Safari Balls\n",
        "from the attendant."
      ]
    },
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_CallYouOnPAWhenYouRunOut",
      "en_US": [
        "We’ll call you on the Pa when you\n",
        "run out of time or Safari Balls.\r",
        "Well, I’ll wish you the best of\n",
        "luck!"
      ]
    },
    {
      "id": "msg_0516_T08R0201_Route121_SafariZoneEntrance_Text_PCIsFull",
      "en_US": [
        "Excuse me!\n",
        "Your PC Box is full."
      ]
    },
    {
      "id": "msg_0516_T08R0201_FuchsiaCity_SafariZone_Entrance_Text_OopsNotEnoughMoney",
      "en_US": [
        "Oops!\n",
        "Not enough money!"
      ]
    },
    {
      "id": "msg_0516_T08R0201_cv_unported",
