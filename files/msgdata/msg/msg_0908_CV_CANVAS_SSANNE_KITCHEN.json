    {
      "id": "msg_0908_CV_CANVAS_SSANNE_KITCHEN_SSAnne_Kitchen_Text_BusyOutOfTheWay",
      "en_US": [
        "You, mon petit!\n",
        "We’re busy here!\f",
        "Out of the way!"
      ]
    },
    {
