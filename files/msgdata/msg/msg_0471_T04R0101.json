  "messages": [
    {
      "id": "msg_0471_T04R0101_CeruleanCity_House1_Text_BadgesHaveAmazingSecrets",
      "en_US": [
        "Only skilled Trainers can collect\n",
        "Pokémon Badges.\r",
        "I see you have at least one.\r",
        "Those Badges have amazing secrets,\n",
        "did you know?"
      ]
    },
    {
      "id": "msg_0471_T04R0101_CeruleanCity_House1_Text_DescribeWhichBadge",
      "en_US": [
        "Now then…\r",
        "Which of the eight Badges should\n",
        "I describe?"
      ]
    },
    {
      "id": "msg_0471_T04R0101_CeruleanCity_House1_Text_AttackStatFlash",
      "en_US": [
        "The Attack stat of all your\n",
        "Pokémon increases a little bit.\r",
        "It also lets you use the move\n",
        "Flash outside of battle."
      ]
    },
    {
      "id": "msg_0471_T04R0101_CeruleanCity_House1_Text_ObeyLv30Cut",
      "en_US": [
        "Pokémon up to Lv. 30 will obey\n",
        "you.\r",
        "That includes even outsiders you\n",
        "obtain in trades.\r",
        "Pokémon of higher levels will\n",
        "be unruly in battle, however.\r",
        "It also lets you use the move\n",
        "Cut outside of battle."
      ]
    },
