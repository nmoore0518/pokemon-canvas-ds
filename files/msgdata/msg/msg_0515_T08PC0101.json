{
  "key": 12115,
  "messages": [
    {
      "id": "msg_0515_T08PC0101_FuchsiaCity_PokemonCenter_1F_Text_CantBecomeGoodTrainerWithOneMon",
      "en_US": [
        "You can’t become a good Trainer\n",
        "with just one strong Pokémon.\r",
        "But raising many Pokémon evenly\n",
        "is no easy task, either."
      ]
    },
    {
      "id": "msg_0515_T08PC0101_FuchsiaCity_PokemonCenter_1F_Text_PokemonLeagueWestOfViridian",
      "en_US": [
        "There’s a narrow trail west of\n",
        "Viridian City.\r",
        "It goes to the Pokémon League Hq.\n",
        "The Hq governs all Trainers."
      ]
    },
    {
      "id": "msg_0515_T08PC0101_FuchsiaCity_PokemonCenter_1F_Text_VisitSafariZoneForPokedex",
      "en_US": [
        "If you’re working on a Pokédex,\n",
        "visit the Safari Zone.\r",
        "All sorts of rare Pokémon breed\n",
        "there."
      ]
    },
    {
      "id": "msg_0515_T08PC0101_MossdeepCity_GameCorner_1F_Text_DescribeWhichGame",
      "en_US": [
        "I can explain game rules to you,\n",
        "if you’d like.\r",
        "Which game should I describe?"
      ]
    },
    {
      "id": "msg_0515_T08PC0101_cv_mc_wireless_minigame_0",
      "en_US": "Pokémon Jump"
    },
    {
      "id": "msg_0515_T08PC0101_cv_mc_wireless_minigame_1",
      "en_US": "Dodrio Berry-Picking"
    },
    {
      "id": "msg_0515_T08PC0101_cv_mc_wireless_minigame_2",
      "en_US": "Exit"
    },
    {
      "id": "msg_0515_T08PC0101_MossdeepCity_GameCorner_1F_Text_PokemonJumpInfo",
      "en_US": [
        "“Pokémon Jump”\r",
        "Make your Pokémon skip the Vine Whip\n",
        "rope with the A Button.\r",
        "Only mini Pokémon around 28 inches\n",
        "or less may participate.\r",
        "Pokémon that only swim, burrow,\n",
        "or fly are not good at jumping.\r",
        "As a result, those Pokémon may not\n",
        "participate.\r",
        "Good things happen if everyone\n",
        "jumps in time."
      ]
    },
    {
      "id": "msg_0515_T08PC0101_MossdeepCity_GameCorner_1F_Text_DodrioBerryPickingInfo",
      "en_US": [
        "“Dodrio Berry-Picking”\r",
        "Command Dodrio’s three heads to\n",
        "catch falling Berries.\r",
        "Press right, up, or left on the\n",
        " Control Pad to move the heads.\r",
        "To play this game, you must have\n",
        "a Dodrio."
      ]
    },
    {
      "id": "msg_0515_T08PC0101_MossdeepCity_GameCorner_1F_Text_TalkToOldManToPlay",
      "en_US": [
        "If you want to play a game,\n",
        "please tell the old man beside me."
      ]
    },
    {
      "id": "msg_0515_T08PC0101_cv_unported",
      "en_US": [
        "(Canvas DS: this part of the game\n",
        "isn’t ported yet.)"
      ]
    }
  ]
}
