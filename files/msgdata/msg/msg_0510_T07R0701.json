  "messages": [
    {
      "id": "msg_0510_T07R0701_CeladonCity_Restaurant_Text_TakingBreakRightNow",
      "en_US": [
        "Hi!\r",
        "Sorry, but we’re taking a break\n",
        "right now."
      ]
    },
    {
      "id": "msg_0510_T07R0701_CeladonCity_Restaurant_Text_OftenGoToDrugstore",
      "en_US": [
        "My Pokémon are weak, so I often\n",
        "have to go to the Drugstore."
      ]
    },
    {
      "id": "msg_0510_T07R0701_CeladonCity_Restaurant_Text_ManLostItAllAtSlots",
      "en_US": [
        "Munch…\r",
        "The man at that table lost it all\n",
        "at the slots."
      ]
    },
    {
      "id": "msg_0510_T07R0701_CeladonCity_Restaurant_Text_TakeThisImBusted",
      "en_US": [
        "Go ahead! Laugh!\n",
        "I’m flat-out busted!\r",
        "No more slots for me!\n",
        "I’m going straight!\r",
        "Here!\n",
        "I won’t be needing this anymore!"
      ]
    },
    {
      "id": "msg_0510_T07R0701_CeladonCity_Restaurant_Text_ReceivedCoinCaseFromMan",
      "en_US": [
        "{STRVAR_1 3, 6, 0} received a Coin Case\n",
        "from the man."
      ]
    },
    {
      "id": "msg_0510_T07R0701_CeladonCity_Restaurant_Text_PsstBasementUnderGameCorner",
      "en_US": [
        "Psst! There’s a basement under the\n",
        "Game Corner, I hear."
      ]
    },
    {
      "id": "msg_0510_T07R0701_PaintWorld_Text_FigureFirst",
      "en_US": [
        "… … …\r",
        "A figure made of paint turns to\n",
        "face you. It raises a brush."
      ]
    },
    {
      "id": "msg_0510_T07R0701_CeladonCity_Restaurant_Text_ThoughtIdWinItBack",
      "en_US": [
        "I always thought I was going to\n",
        "win it back…"
      ]
    },
    {
      "id": "msg_0510_T07R0701_CeladonCity_Restaurant_Text_MakeRoomForThis",
      "en_US": "Make room for this!"
    },
    {
      "id": "msg_0510_T07R0701_PaintWorld_Text_FigureSketch",
      "en_US": [
        "… … …\r",
        "The figure’s colors swirl.\n",
        "It’s waiting for you."
      ]
    },
    {
      "id": "msg_0510_T07R0701_PaintWorld_Text_FigureMega",
      "en_US": [
        "… … …\r",
        "The figure is holding a stone that\n",
        "shines in every color."
      ]
    },
    {
      "id": "msg_0510_T07R0701_PaintWorld_Text_Dissolve",
      "en_US": [
        "The figure runs like wet paint…\n",
        "The world around it does too."
      ]
    },
    {
      "id": "msg_0510_T07R0701_cv_unported",
      "en_US": [
        "(Canvas DS: this part of the game\n",
        "isn’t ported yet.)"
      ]
    }
  ]
