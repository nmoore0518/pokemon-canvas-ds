{
  "key": 19858,
  "messages": [
    {
      "id": "msg_0871_CV_CANVAS_DIGLETTS_CAVE_N_DiglettsCave_NorthEntrance_RockTunnelPitchBlack",
      "en_US": [
        "I went inside Rock Tunnel, but it’s\n",
        "pitch-black and scary in there.\r",
        "If I could get a Pokémon to use\n",
        "Flash and light it up…"
      ]
    },
    {
      "id": "msg_0871_CV_CANVAS_DIGLETTS_CAVE_N_PaintWorld_Text_FigureFirst",
      "en_US": [
        "… … …\r",
        "A figure made of paint turns to\n",
        "face you. It raises a brush."
      ]
    },
    {
      "id": "msg_0871_CV_CANVAS_DIGLETTS_CAVE_N_PaintWorld_Text_FigureSketch",
      "en_US": [
        "… … …\r",
        "The figure’s colors swirl.\n",
        "It’s waiting for you."
      ]
    },
    {
      "id": "msg_0871_CV_CANVAS_DIGLETTS_CAVE_N_PaintWorld_Text_FigureMega",
      "en_US": [
        "… … …\r",
        "The figure is holding a stone that\n",
        "shines in every color."
      ]
    },
    {
      "id": "msg_0871_CV_CANVAS_DIGLETTS_CAVE_N_PaintWorld_Text_Dissolve",
      "en_US": [
        "The figure runs like wet paint…\n",
        "The world around it does too."
      ]
    },
    {
      "id": "msg_0871_CV_CANVAS_DIGLETTS_CAVE_N_cv_unported",
      "en_US": [
        "(Canvas DS: this part of the game\n",
        "isn’t ported yet.)"
      ]
    }
  ]
}
