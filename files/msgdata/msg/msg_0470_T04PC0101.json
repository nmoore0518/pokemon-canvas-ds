{
  "key": 11987,
  "messages": [
    {
      "id": "msg_0470_T04PC0101_CeruleanCity_PokemonCenter_1F_Text_EveryoneCallsBillPokemaniac",
      "en_US": [
        "Have you heard about Bill?\r",
        "Everyone calls him a PokéMANIAC!\r",
        "I think people are just jealous of\n",
        "Bill, though.\r",
        "Who wouldn’t want to boast about\n",
        "their Pokémon?"
      ]
    },
    {
      "id": "msg_0470_T04PC0101_CeruleanCity_PokemonCenter_1F_Text_BillDoesWhateverForRareMons",
      "en_US": [
        "That Bill!\r",
        "I heard that he’ll do whatever it\n",
        "takes to get rare Pokémon.\r",
        "He’s not above doing all sorts\n",
        "of things, I’ve heard."
      ]
    },
    {
      "id": "msg_0470_T04PC0101_CeruleanCity_PokemonCenter_1F_Text_BillCollectsRareMons",
      "en_US": [
        "Bill has lots of Pokémon!\n",
        "He collects rare ones, too!"
      ]
    },
    {
      "id": "msg_0470_T04PC0101_CeruleanCity_PokemonCenter_1F_Text_TryTradingUpstairs",
      "en_US": [
        "Why don’t you go upstairs and try\n",
        "trading Pokémon with your friends?\r",
        "You could get a lot more variety\n",
        "by trading.\r",
        "The Pokémon you get in trades grow\n",
        "quickly, too."
      ]
    },
    {
      "id": "msg_0470_T04PC0101_PokemonJournal_Text_SpecialFeatureMisty",
      "en_US": [
        "Pokémon Journal\r",
        "Special Feature: Cerulean Gym\n",
        "Leader Misty!\r",
        "Misty is said to worship Lorelei\n",
        "of the Elite Four."
      ]
    },
    {
      "id": "msg_0470_T04PC0101_MossdeepCity_GameCorner_1F_Text_DescribeWhichGame",
      "en_US": [
        "I can explain game rules to you,\n",
        "if you’d like.\r",
        "Which game should I describe?"
      ]
    },
    {
      "id": "msg_0470_T04PC0101_cv_mc_wireless_minigame_0",
      "en_US": "Pokémon Jump"
    },
    {
      "id": "msg_0470_T04PC0101_cv_mc_wireless_minigame_1",
      "en_US": "Dodrio Berry-Picking"
    },
    {
      "id": "msg_0470_T04PC0101_cv_mc_wireless_minigame_2",
      "en_US": "Exit"
    },
    {
      "id": "msg_0470_T04PC0101_MossdeepCity_GameCorner_1F_Text_PokemonJumpInfo",
      "en_US": [
        "“Pokémon Jump”\r",
        "Make your Pokémon skip the Vine Whip\n",
        "rope with the A Button.\r",
        "Only mini Pokémon around 28 inches\n",
        "or less may participate.\r",
        "Pokémon that only swim, burrow,\n",
        "or fly are not good at jumping.\r",
        "As a result, those Pokémon may not\n",
        "participate.\r",
        "Good things happen if everyone\n",
        "jumps in time."
      ]
    },
    {
      "id": "msg_0470_T04PC0101_MossdeepCity_GameCorner_1F_Text_DodrioBerryPickingInfo",
      "en_US": [
        "“Dodrio Berry-Picking”\r",
        "Command Dodrio’s three heads to\n",
        "catch falling Berries.\r",
        "Press right, up, or left on the\n",
        " Control Pad to move the heads.\r",
        "To play this game, you must have\n",
        "a Dodrio."
      ]
    },
    {
      "id": "msg_0470_T04PC0101_MossdeepCity_GameCorner_1F_Text_TalkToOldManToPlay",
      "en_US": [
        "If you want to play a game,\n",
        "please tell the old man beside me."
      ]
    },
    {
      "id": "msg_0470_T04PC0101_cv_unported",
      "en_US": [
        "(Canvas DS: this part of the game\n",
        "isn’t ported yet.)"
      ]
    }
  ]
}
