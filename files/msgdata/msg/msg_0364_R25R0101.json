  "messages": [
    {
      "id": "msg_0364_R25R0101_Route25_SeaCottage_Text_TeleporterIsDisplayed",
      "en_US": [
        "Teleporter is displayed on the PC\n",
        "monitor."
      ]
    },
    {
      "id": "msg_0364_R25R0101_Route25_SeaCottage_Text_CheckOutRareMonsOnPC",
      "en_US": [
        "Bill: Feel like checking out some\n",
        "of my rare Pokémon on my PC?\r",
        "Go on, check out my PC."
      ]
    },
    {
      "id": "msg_0364_R25R0101_Route25_SeaCottage_Text_SSAnnePartyYouGoInstead",
      "en_US": [
        "That cruise ship S.S. Anne is in\n",
        "Vermilion City.\r",
        "I hear there are lots of Trainers\n",
        "on board, too.\r",
        "They invited me to their party, but\n",
        "I can’t stand fancy do’s.\r",
        "Why don’t you go instead of me?\n",
        "Go on and have a good time."
      ]
    },
    {
      "id": "msg_0364_R25R0101_Route25_SeaCottage_Text_ReceivedSSTicketFromBill",
      "en_US": [
        "{STRVAR_1 3, 6, 0} received an S.S. Ticket\n",
        "from Bill."
      ]
    },
    {
      "id": "msg_0364_R25R0101_Route25_SeaCottage_Text_ImBillHelpMeOutPal",
      "en_US": [
        "Hiya! I’m a Pokémon…\n",
        "…No I’m not!\r",
        "Call me Bill!\n",
        "I’m a true-blue PokéMANIAC!\r",
        "Hey!\n",
        "What’s with that skeptical look?\r",
        "I’m not joshing you, pal.\r",
        "I screwed up an experiment and got\n",
        "combined with a Pokémon!\r",
        "So, how about it?\n",
        "Help me out here!"
      ]
    },
    {
      "id": "msg_0364_R25R0101_Route25_SeaCottage_Text_ImBillHelpMeOutLady",
      "en_US": [
        "Hiya! I’m a Pokémon…\n",
        "…No I’m not!\r",
        "Call me Bill!\n",
        "I’m a true-blue PokéMANIAC!\r",
        "Hey!\n",
        "What’s with that skeptical look?\r",
        "I’m not joshing you, lady.\r",
        "I screwed up an experiment and got\n",
        "combined with a Pokémon!\r",
        "So, how about it?\n",
        "Help me out here!"
      ]
    },
    {
      "id": "msg_0364_R25R0101_Route25_SeaCottage_Text_BillsFavoriteMonList",
      "en_US": "Bill’s favorite Pokémon list!"
    },
    {
      "id": "msg_0364_R25R0101_Route25_SeaCottage_Text_InitiatedTeleportersCellSeparator",
      "en_US": [
        "{STRVAR_1 3, 6, 0} initiated the Teleporter’s\n",
        "Cell Separator."
      ]
    },
    {
      "id": "msg_0364_R25R0101_Text_BillPalmPilot",
      "en_US": [
        "Bill: Oh, and one more thing!\r",
        "You know my Pokémon Storage\n",
        "System? I’ve been tinkering…\r",
        "and I made a PC that fits in your\n",
        "pocket! I call it the Palm Pilot.\r",
        "It links to the Storage System\n",
        "from almost anywhere.\r",
        "Not inside the Pokémon League,\n",
        "though. They jam the signal.\r",
        "Here, take this one. Tell me how\n",
        "it works out!"
      ]
    },
    {
      "id": "msg_0364_R25R0101_Text_BillPalmPilotHowTo",
      "en_US": [
        "Bill: Use it from your Bag, or\n",
        "register it to the Select Button."
      ]
    },
    {
      "id": "msg_0364_R25R0101_Text_BillPalmPilotSecret",
      "en_US": [
        "Bill: Oh, and if anyone asks…\n",
        "I’ve only been working on the PC.\r",
        "Some of my other experiments are,\n",
        "uh… not exactly approved.\r",
        "Nothing to worry about! Probably.\n",
        "Heh heh…"
      ]
    },
    {
      "id": "msg_0364_R25R0101_Route25_SeaCottage_Text_ThanksBudTakeThis",
      "en_US": [
        "Bill: Yeehah!\n",
        "Thanks, bud! I owe you one!\r",
        "So, did you come to see my\n",
        "Pokémon collection?\r",
        "You didn’t?\n",
        "That’s a bummer.\r",
        "I’ve got to thank you…\n",
        "Oh, here, maybe this’ll do."
      ]
    },
    {
      "id": "msg_0364_R25R0101_Route25_SeaCottage_Text_ThanksLadyTakeThis",
      "en_US": [
