+BOOL Canvas_RunCmd(SCRIPTCONTEXT *ctx, u8 sw, u16 n)
+{
+    struct SAVE_MISC_DATA *misc = Sav2_Misc_get(SaveBlock2_get());
+    u16 value;
+    if (sw <= CANVAS_CMD_FLAG_CHECK && n >= CANVAS_NUM_FLAGS)
+        return FALSE;
+    if (sw >= CANVAS_CMD_VAR_SET && n >= CANVAS_NUM_VARS)
+        n = 0;
+    switch (sw) {
+    case CANVAS_CMD_FLAG_SET:
+        misc->canvasFlags[n / 8] |= 1 << (n % 8);
+        break;
+    case CANVAS_CMD_FLAG_CLEAR:
+        misc->canvasFlags[n / 8] &= ~(1 << (n % 8));
+        break;
+    case CANVAS_CMD_FLAG_CHECK:      // -> VAR_SPECIAL_RESULT (0x800C)
+        SetScriptVar(0x800C, (misc->canvasFlags[n / 8] >> (n % 8)) & 1);
+        break;
+    case CANVAS_CMD_VAR_SET:         // CanvasVarSet n, value (a value, or a var to read)
+        value = ScriptReadHalfword(ctx);
+        misc->canvasVars[n] = GetScriptVar(value);
+        break;
+    case CANVAS_CMD_VAR_GET:         // CanvasVarGet n, var: copies our var into a game var
+        value = ScriptReadHalfword(ctx);
+        SetScriptVar(value, misc->canvasVars[n]);
+        break;
+    case CANVAS_CMD_VAR_ADD:
+        value = ScriptReadHalfword(ctx);
+        misc->canvasVars[n] += GetScriptVar(value);
+        break;
+    }
+    return FALSE;
+}
