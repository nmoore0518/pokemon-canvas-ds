+// The GBA game's team rules (its src/gym_hack.c GymHack_CheckTeamRules): eggs don't count. On a break, the
+// message's names: wrong type -> slot 0 the Pokemon's nickname, 1 its type, 2 the player's; two alike -> slot 0
+// the species; two holding one item -> slot 0 the item.
+static u32 Canvas_CheckTeam(MessageFormat *fmt, u32 rules, u32 playerType)
+{
+    struct Party *party = SaveArray_Party_Get(SaveBlock2_get());
+    int n = PokeParty_GetPokeCount(party), i, j;
+    for (i = 0; i < n; i++) {
+        struct PartyPokemon *mon = Party_GetMonByIndex(party, i);
+        u32 species = GetMonData(mon, MON_DATA_SPECIES, NULL), item = GetMonData(mon, MON_DATA_HELD_ITEM, NULL);
+        if (species == 0 || GetMonData(mon, MON_DATA_IS_EGG, NULL))
+            continue;
+        if ((rules & CANVAS_TEAM_RULE_TYPE) && GetMonData(mon, MON_DATA_TYPE_1, NULL) != playerType) {
+            BufferBoxMonNickname(fmt, 0, (struct BoxPokemon *)mon);
+            BufferTypeName(fmt, 1, GetMonData(mon, MON_DATA_TYPE_1, NULL));
+            BufferTypeName(fmt, 2, playerType);
+            return 1;
+        }
+        for (j = i + 1; j < n; j++) {
+            struct PartyPokemon *other = Party_GetMonByIndex(party, j);
+            u32 sp = GetMonData(other, MON_DATA_SPECIES, NULL);
+            if (sp == 0 || GetMonData(other, MON_DATA_IS_EGG, NULL))
+                continue;
+            if ((rules & CANVAS_TEAM_RULE_SPECIES) && sp == species) {
+                BufferSpeciesName(fmt, 0, species);
+                return 2;
+            }
+            if ((rules & CANVAS_TEAM_RULE_ITEM) && item != 0 && GetMonData(other, MON_DATA_HELD_ITEM, NULL) == item) {
+                BufferItemName(fmt, 0, item);
+                return 3;
+            }
+        }
+    }
+    return 0;
+}
+
+BOOL Canvas_RunCmd(SCRIPTCONTEXT *ctx, u8 sw, u16 n)
+{
+    struct SAVE_MISC_DATA *misc = Sav2_Misc_get(SaveBlock2_get());
+    u16 value;
+    if (sw <= CANVAS_CMD_FLAG_CHECK && n >= CANVAS_NUM_FLAGS)
+        return FALSE;
+    if (sw >= CANVAS_CMD_VAR_SET && n >= CANVAS_NUM_VARS)
+        n = 0;
+    switch (sw) {
+    case CANVAS_CMD_FLAG_SET:
+        misc->canvasFlags[n / 8] |= 1 << (n % 8);
+        break;
+    case CANVAS_CMD_FLAG_CLEAR:
+        misc->canvasFlags[n / 8] &= ~(1 << (n % 8));
+        break;
+    case CANVAS_CMD_FLAG_CHECK:      // -> VAR_SPECIAL_RESULT (0x800C)
+        SetScriptVar(0x800C, (misc->canvasFlags[n / 8] >> (n % 8)) & 1);
+        break;
+    case CANVAS_CMD_VAR_SET:         // CanvasVarSet n, value (a value, or a var to read)
+        value = ScriptReadHalfword(ctx);
+        misc->canvasVars[n] = GetScriptVar(value);
+        break;
+    case CANVAS_CMD_VAR_GET:         // CanvasVarGet n, var: copies our var into a game var
+        value = ScriptReadHalfword(ctx);
+        SetScriptVar(value, misc->canvasVars[n]);
+        break;
+    case CANVAS_CMD_VAR_ADD:
+        value = ScriptReadHalfword(ctx);
+        misc->canvasVars[n] += GetScriptVar(value);
+        break;
+    }
+    return FALSE;
+}
