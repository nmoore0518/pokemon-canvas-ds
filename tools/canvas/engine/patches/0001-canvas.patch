+// ---------------------------------------------------------------- where visitors stand and walk
+#define PATH_MAX CANVAS_PATH_MAX
+
+// (a square nobody stands on: the player's following Pokemon doesn't count - it's out of sight while a script
+// runs, and the visitor would otherwise stand beside the player instead of in front)
+#define OBJ_FOLLOWER 253
+static BOOL Free(FieldSystem *fsys, int x, int z)
+{
+    void *o = Cv_GetObjectAt(fsys->mapObjectMan, x, z, FALSE);
+    return !Cv_Blocked(fsys, x, z) && (o == NULL || *(u32 *)((u8 *)o + 8) == OBJ_FOLLOWER);
+}
+
+static void PlayerXZ(FieldSystem *fsys, int *x, int *z, u32 *facing)
+{
+    void *p = Cv_GetObjectById(fsys, OBJ_PLAYER);
+    *x = Cv_ObjX(p); *z = Cv_ObjZ(p);
+    if (facing) *facing = Cv_ObjFacing(p);
+}
+
+// GymCandidate_PlaceGuest: a free square next to the player, behind them first -> 0x8005/6, result
+static void Canvas_PlaceGuest(FieldSystem *fsys)
+{
+    int px, pz, i;
+    u32 facing, order[4];
+    PlayerXZ(fsys, &px, &pz, &facing);
+    sGuestDir = sOpposite[facing];
+    sFacingBefore = facing;
+    sVisitorWalked = FALSE;
+    order[0] = sOpposite[facing];
+    order[1] = (facing == DIR_N || facing == DIR_S) ? DIR_W : DIR_N;
+    order[2] = sOpposite[order[1]];
+    order[3] = facing;
+    SetScriptVar(VAR_RESULT, FALSE);
+    for (i = 0; i < 4; i++) {
+        int x = px + sDx[order[i]], z = pz + sDz[order[i]];
+        if (Free(fsys, x, z)) {
+            SetScriptVar(0x8005, x); SetScriptVar(0x8006, z);
+            sGuestDir = order[i];
+            SetScriptVar(VAR_RESULT, TRUE);
+            return;
+        }
+    }
+}
+
+// GymCandidate_FaceGuest / FaceBack
+static void Canvas_FaceGuest(FieldSystem *fsys, u16 objId)
+{
+    void *o = Cv_GetObjectById(fsys, objId);
+    if (o) Cv_ObjFace(o, sOpposite[sGuestDir]);
+    Cv_ObjFace(Cv_GetObjectById(fsys, OBJ_PLAYER), sGuestDir);
+}
+
+// GymCandidate_PlanVisitorWalk: from the map's door (its lowest warp) to the player, by a search over the squares
+// round them (frontOnly: ending right in front of the player) -> 0x8005/6 the door, result; the walks in sWalkIn/Out
+#define BOX 48
+static void Canvas_PlanVisitorWalk(FieldSystem *fsys, BOOL frontOnly)
+{
+    int px, pz, sx = -1, sz = -1, x0, z0, i, head = 0, tail = 0, start, goal = -1;
+    u32 facing;
+    const struct CvWarp *w;
+    s16 *from, *queue;
+    u8 *dir;
+    SetScriptVar(VAR_RESULT, FALSE);
+    sVisitorWalked = FALSE;
+    PlayerXZ(fsys, &px, &pz, &facing);
+    sFacingBefore = facing;
+    for (i = 0; (w = Cv_Warp(fsys, i)) != NULL; i++)
+        if (w->z > sz) { sx = w->x; sz = w->z; }
+    if (sx < 0) return;
+    x0 = ((px + sx) / 2) - BOX / 2;                     // (the box searched: round the player and the door)
+    z0 = ((pz + sz) / 2) - BOX / 2;
+    if (sx - x0 < 0 || sx - x0 >= BOX || sz - z0 < 0 || sz - z0 >= BOX || px - x0 < 0 || px - x0 >= BOX || pz - z0 < 0 || pz - z0 >= BOX)
+        return;
+    from = Cv_Heap_Alloc(HEAP_ID_FIELD1, BOX * BOX * sizeof(s16));
+    queue = Cv_Heap_Alloc(HEAP_ID_FIELD1, BOX * BOX * sizeof(s16));
+    dir = Cv_Heap_Alloc(HEAP_ID_FIELD1, BOX * BOX);
+    for (i = 0; i < BOX * BOX; i++) from[i] = -1;
+    start = (sx - x0) + (sz - z0) * BOX;
+    from[start] = start;
+    queue[tail++] = start;
+    while (head < tail && goal < 0) {
+        int cur = queue[head++], x = cur % BOX, z = cur / BOX;
+        for (i = 0; i < 4; i++) {
+            if (x + x0 + sDx[i] == px && z + z0 + sDz[i] == pz
+             && (!frontOnly || (x + x0 == px + sDx[sFacingBefore] && z + z0 == pz + sDz[sFacingBefore]))) {
+                goal = cur;
+                dir[start] = i;      // (the way to face, kept in an unused slot)
+                break;
+            }
+        }
+        for (i = 0; i < 4 && goal < 0; i++) {
+            int nx = x + sDx[i], nz = z + sDz[i], next = nx + nz * BOX;
+            if (nx < 0 || nz < 0 || nx >= BOX || nz >= BOX || from[next] >= 0 || !Free(fsys, nx + x0, nz + z0))
+                continue;
+            from[next] = cur;
+            dir[next] = i;
+            queue[tail++] = next;
+        }
+    }
+    if (goal >= 0 && goal != start) {
+        int steps = 0, c, faceDir = dir[start];
+        for (c = goal; c != start; c = from[c]) steps++;
+        if (steps <= PATH_MAX) {
+            int n = steps;
+            for (c = goal; c != start; c = from[c]) {
+                n--;
+                sWalkIn[n] = dir[c];
+                sWalkOut[steps - 1 - n] = sOpposite[dir[c]];      // (the way back, in reverse)
+            }
+            sWalkIn[steps] = faceDir;
+            sWalkLen = steps;
+            sGuestDir = sOpposite[faceDir];
+            SetScriptVar(0x8005, sx); SetScriptVar(0x8006, sz);
+            SetScriptVar(VAR_RESULT, TRUE);
+            sVisitorWalked = TRUE;
+        }
+    }
+    Cv_Heap_Free(from); Cv_Heap_Free(queue); Cv_Heap_Free(dir);
+}
+
+// A walk of ours for a person, as ApplyMovement does (ScrCmd_563's way: the commands freed when it's done)
+static void Apply(FieldSystem *fsys, u16 objId, const u8 *dirs, int n, u32 kind, int face)
+{
+    void *o = Cv_GetObjectById(fsys, objId), *man;
+    struct CvMove *cmd;
+    int i, k = 0;
+    if (o == NULL) return;
+    cmd = Cv_Heap_Alloc(HEAP_ID_FIELD1, (n + 2) * sizeof(struct CvMove));
+    for (i = 0; i < n; i++) {
+        if (k && cmd[k - 1].command == kind + dirs[i]) cmd[k - 1].length++;
+        else { cmd[k].command = kind + dirs[i]; cmd[k].length = 1; k++; }
+    }
+    if (face >= 0) { cmd[k].command = MOVE_FACE + face; cmd[k].length = 1; k++; }
+    cmd[k].command = MOVE_END; cmd[k].length = 0;
+    man = Cv_MovementCreate(o, cmd);
+    (*(u8 *)Cv_SysAttr(fsys, SCRIPTENV_NUM_ACTIVE_MOVEMENT))++;
+    Cv_MovementSchedule(fsys, man, cmd);
+}
+
+// ---------------------------------------------------------------- holding the gym: the player on the leader's spot
+
+// GymCandidate_PlanHold: the leader (the last one talked to) right in front of the player; a square for them to
+// watch from. The GBA's leader steps two squares to the side; HeartGold's leaders stand on narrow daises, so ours
+// looks over the squares they can walk to round the spot for one off to the side and a little out in front (out
+// of the way of the challenger's walk up the middle): best about 3 squares aside and 2 forward
+#define HOLD_R 5
+#define HOLD_N (2 * HOLD_R + 1)
+static void Canvas_PlanHold(FieldSystem *fsys)
+{
+    int px, pz, l, f, i, best = 99, grown = 1;
+    u8 sq[HOLD_N][HOLD_N];         // (round the spot: 0 closed, 1 open, 2 open and reached from the spot)
+    u32 facing;
+    void *leader = Cv_GetObjectById(fsys, GetScriptVar(VAR_LAST_TALKED));
+    SetScriptVar(VAR_RESULT, FALSE);
+    sHolding = FALSE;
+    if (leader == NULL) return;
+    PlayerXZ(fsys, &px, &pz, &facing);
+    if (px + sDx[facing] != (int)Cv_ObjX(leader) || pz + sDz[facing] != (int)Cv_ObjZ(leader)) return;
+    sHoldDir = facing;
+    sLeaderX = Cv_ObjX(leader); sLeaderZ = Cv_ObjZ(leader);
+    for (i = 0; i < HOLD_N * HOLD_N; i++) {
+        int x = sLeaderX - HOLD_R + i % HOLD_N, z = sLeaderZ - HOLD_R + i / HOLD_N;
+        sq[i / HOLD_N][i % HOLD_N] = (x == px && z == pz) || Free(fsys, x, z);
+    }
+    sq[HOLD_R][HOLD_R] = 2;
+    while (grown)                  // (the squares they can walk to from the spot, without leaving the box)
+        for (grown = 0, i = 0; i < HOLD_N * HOLD_N; i++) {
+            int r = i / HOLD_N, c = i % HOLD_N;
+            if (sq[r][c] == 1 && ((r && sq[r - 1][c] == 2) || (r < HOLD_N - 1 && sq[r + 1][c] == 2)
+                               || (c && sq[r][c - 1] == 2) || (c < HOLD_N - 1 && sq[r][c + 1] == 2)))
+                sq[r][c] = 2, grown = 1;
+        }
+    for (f = 0; f <= 4; f++)                 // (f: squares out in front of the spot, l: to the side)
+        for (l = -HOLD_R; l <= HOLD_R; l++) {
+            // (forward is back toward where the player stood; the side, square to it)
+            int dx = -f * sDx[facing] + l * sDz[facing], dz = -f * sDz[facing] + l * sDx[facing];
+            int a = l < 0 ? -l : l, cost = (f > 2 ? f - 2 : 2 - f) + (a > 3 ? a - 3 : 3 - a) + (a < 2 ? 4 : 0);
+            const struct CvWarp *w;
+            if (dx < -HOLD_R || dx > HOLD_R || dz < -HOLD_R || dz > HOLD_R || sq[dz + HOLD_R][dx + HOLD_R] != 2
+             || (!l && !f) || (dx == px - sLeaderX && dz == pz - sLeaderZ))
+                continue;
+            // (a wall right below hides all but their head; a warp - a door, a pad - isn't a place to stand)
+            if (dz + 1 > HOLD_R || !sq[dz + 1 + HOLD_R][dx + HOLD_R]) cost += 3;
+            for (i = 0; (w = Cv_Warp(fsys, i)) != NULL; i++)
+                if (w->x == sLeaderX + dx && w->z == sLeaderZ + dz) cost = 99;
+            if (cost < best) { best = cost; sAsideX = sLeaderX + dx; sAsideZ = sLeaderZ + dz; }
+        }
+    if (best < 99) {
+        sHoldLeaderId = GetScriptVar(VAR_LAST_TALKED);
+        sHolding = TRUE;
+        SetScriptVar(VAR_RESULT, TRUE);
+    }
+}
+
+static u32 DirToward(int fx, int fz, int tx, int tz)
+{
+    int dx = tx - fx, dz = tz - fz;
+    if ((dx < 0 ? -dx : dx) > (dz < 0 ? -dz : dz)) return dx < 0 ? DIR_W : DIR_E;
+    return dz < 0 ? DIR_N : DIR_S;
+}
+
+// GymCandidate_HoldLeaderAside (in the dark: aside, facing their spot, or out of sight for a shift) / Back
+static void Canvas_HoldLeader(FieldSystem *fsys, BOOL back, BOOL shift)
+{
+    void *leader = sHolding ? Cv_GetObjectById(fsys, sHoldLeaderId) : NULL;
+    if (leader == NULL) return;
+    if (back) {
+        Cv_ObjPlace(leader, sLeaderX, Cv_ObjY(leader), sLeaderZ, sOpposite[sHoldDir]);
+        Cv_ObjSetVisible(leader, FALSE);
+        sHolding = FALSE;
+    } else {
+        Cv_ObjPlace(leader, sAsideX, Cv_ObjY(leader), sAsideZ,      // (facing the battle: the square before the spot)
+                    DirToward(sAsideX, sAsideZ, sLeaderX - sDx[sHoldDir], sLeaderZ - sDz[sHoldDir]));
+        Cv_ObjSetVisible(leader, shift);
+    }
+}
+
+// ---------------------------------------------------------------- the Pokemon Tower's ghost girl
+// (the GBA's src/tower_graves.c: TowerGraves_SummonGhosts / DismissGhosts) The girl and her Scyther appear near the
+// player - the girl two squares off if there's room (else three, else one), her Scyther beside her - facing the
+// player, who turns to her. They flicker in (there more and more often), and while she speaks they're there every
+// other frame (half there: the GBA blends them); later they flicker out. The script shows them first (their flag
+// cleared) and takes them away after.
+void LONG_CALL SetupNativeScript(SCRIPTCONTEXT *ctx, BOOL (*fn)(SCRIPTCONTEXT *));
+void Canvas_BadgeShow(FieldSystem *fsys, u32 type);     // (field/canvas_badge.c)
+void Canvas_BadgeHide(void);
+#define Cv_SysTaskCreate FN(0x0200E320, void *, (void (*)(void *, void *), void *, u32))   // SysTask_CreateOnMainQueue
+#define Cv_SysTaskDestroy FN(0x0200E390, void, (void *))
+#define GHOST_STEPS 60
+static struct { void *task; u16 ids[2]; u8 frame; } sHaunt;
+
+static void GhostsShow(FieldSystem *fsys, const u16 *ids, BOOL show)
+{
+    u32 i;
+    for (i = 0; i < 2; i++) {
+        void *o = Cv_GetObjectById(fsys, ids[i]);
+        if (o != NULL) Cv_ObjSetVisible(o, !show);
+    }
+}
+
+static void Haunt_Task(void *task, void *data)
+{
+    GhostsShow(gFieldSysPtr, sHaunt.ids, (++sHaunt.frame & 1));
+}
+
+static void Haunt_Stop(void)
+{
+    if (sHaunt.task != NULL) Cv_SysTaskDestroy(sHaunt.task);
+    sHaunt.task = NULL;
+}
+
+// data[0] the frame, [1] in (else out), [2] [3] the girl's and her Scyther's ids
+static BOOL Ghosts_Step(SCRIPTCONTEXT *ctx)
+{
+    u32 step = ctx->data[0], in = ctx->data[1], there = in ? step : GHOST_STEPS - step;
+    u16 ids[2] = {ctx->data[2], ctx->data[3]};
+    GhostsShow(ctx->fsys, ids, step >= GHOST_STEPS ? in : Rand(GHOST_STEPS) < there);
+    if (++ctx->data[0] <= GHOST_STEPS) return FALSE;
+    if (in) {
+        sHaunt.ids[0] = ids[0]; sHaunt.ids[1] = ids[1]; sHaunt.frame = 0;
+        sHaunt.task = Cv_SysTaskCreate(Haunt_Task, NULL, 10);
+    }
+    return TRUE;
+}
+
+static BOOL Ghosts_Start(SCRIPTCONTEXT *ctx, u32 girl, u32 scyther, BOOL in)
+{
+    Haunt_Stop();
+    ctx->data[0] = 0; ctx->data[1] = in; ctx->data[2] = girl; ctx->data[3] = scyther;
+    SetupNativeScript(ctx, Ghosts_Step);
+    return TRUE;
+}
+
+// -> whether there was room (none: they stay out of sight, and she speaks unseen)
+static BOOL Ghosts_Place(FieldSystem *fsys, u32 girlId, u32 scytherId)
+{
+    static const u8 sDistances[] = {2, 3, 1};
+    void *girl = Cv_GetObjectById(fsys, girlId), *scyther = Cv_GetObjectById(fsys, scytherId);
+    void *player = Cv_GetObjectById(fsys, OBJ_PLAYER);
+    int px, pz, dx, dz, d, k;
+    if (girl == NULL || scyther == NULL || player == NULL) return FALSE;
+    Cv_ObjSetVisible(girl, TRUE);
+    Cv_ObjSetVisible(scyther, TRUE);
+    PlayerXZ(fsys, &px, &pz, NULL);
+    for (d = 0; d < 3; d++) {
+        for (dz = -3; dz <= 3; dz++) {
+            for (dx = -3; dx <= 3; dx++) {
+                int gx = px + dx, gz = pz + dz;
+                if ((dx < 0 ? -dx : dx) + (dz < 0 ? -dz : dz) != sDistances[d] || !Free(fsys, gx, gz)) continue;
+                for (k = 0; k < 4; k++) {
+                    static const u8 sBeside[] = {DIR_E, DIR_W, DIR_S, DIR_N};
+                    int sx = gx + sDx[sBeside[k]], sz = gz + sDz[sBeside[k]];
+                    if ((sx == px && sz == pz) || !Free(fsys, sx, sz)) continue;
+                    Cv_ObjPlace(girl, gx, Cv_ObjY(player), gz, DirToward(gx, gz, px, pz));
+                    Cv_ObjPlace(scyther, sx, Cv_ObjY(player), sz, DirToward(sx, sz, px, pz));
+                    Cv_ObjFace(player, DirToward(px, pz, gx, gz));
+                    return TRUE;
+                }
+            }
+        }
+    }
+    return FALSE;
+}
+
+// ---------------------------------------------------------------- the camera's trip to the Gym Legend and back
+// (the GBA's GymLegend_PlanCamera): HeartGold's camera object (ScrCmd_102 makes it on the player, id 241) walks
+// fast up or down, then across, to the square below a, b; then back the same way
+#define OBJ_CAMERA 241
+#define CAMERA_PATH_MAX 48
+static u8 sCameraPath[CAMERA_PATH_MAX], sCameraLen;
+
+static void Canvas_CameraTrip(FieldSystem *fsys, int tx, int tz, BOOL back)
+{
+    void *cam = Cv_GetObjectById(fsys, OBJ_CAMERA);
+    u8 dirs[CAMERA_PATH_MAX];
+    int dx, dz, i, n = 0;
+    if (cam == NULL) return;
+    if (back) {
+        for (i = 0; i < sCameraLen; i++) dirs[i] = sOpposite[sCameraPath[sCameraLen - 1 - i]];
+        Apply(fsys, OBJ_CAMERA, dirs, sCameraLen, MOVE_FAST, -1);
+        return;
+    }
+    dx = tx - (int)Cv_ObjX(cam); dz = tz - (int)Cv_ObjZ(cam);
+    for (i = 0; i < (dz < 0 ? -dz : dz) && n < CAMERA_PATH_MAX / 2; i++) sCameraPath[n++] = dz < 0 ? DIR_N : DIR_S;
+    for (i = 0; i < (dx < 0 ? -dx : dx) && n < CAMERA_PATH_MAX; i++) sCameraPath[n++] = dx < 0 ? DIR_W : DIR_E;
+    sCameraLen = n;
+    Apply(fsys, OBJ_CAMERA, sCameraPath, n, MOVE_FAST, -1);
+}
+
+// ---------------------------------------------------------------- the command
+// CanvasCandidate op, a, b, c, d (a..d: values, or vars)
+BOOL Canvas_CandidateCmd(SCRIPTCONTEXT *ctx, u16 op)
+{
+    FieldSystem *fsys = ctx->fsys;
+    u16 a = GetScriptVar(ScriptReadHalfword(ctx)), b = GetScriptVar(ScriptReadHalfword(ctx));
+    u16 c = GetScriptVar(ScriptReadHalfword(ctx)), d = GetScriptVar(ScriptReadHalfword(ctx));
+    u8 dirs[2];
+    switch (op) {
+    case 0: SetScriptVar(VAR_RESULT, Canvas_GenerateGuest(a, b, c, d)); break;      // level, party size, tier, repeat
+    case 1: Canvas_PlaceGuest(fsys); break;
+    case 2: Canvas_FaceGuest(fsys, a); break;                                         // the visitor's id
+    case 3: Cv_ObjFace(Cv_GetObjectById(fsys, OBJ_PLAYER), sFacingBefore); break;    // FaceBack
+    case 4:                                                                            // a: front only (else anywhere)
+        Canvas_PlanVisitorWalk(fsys, a);
+        if (a && !GetScriptVar(VAR_RESULT)) Canvas_PlanVisitorWalk(fsys, FALSE);
+        break;
+    case 5:                                                                            // a: the visitor, b: 0 in / 1 out
+        if (b) Apply(fsys, a, sWalkOut, sWalkLen, MOVE_WALK, -1);
+        else Apply(fsys, a, sWalkIn, sWalkLen, MOVE_WALK, sWalkIn[sWalkLen]);
+        break;
+    case 6: SetScriptVar(VAR_RESULT, sVisitorWalked); break;
+    case 7: Canvas_PlanHold(fsys); break;
+    case 8: Canvas_HoldLeader(fsys, FALSE, a); break;                                 // a: a shift (the leader leaves)
+    case 9: SetScriptVar(VAR_RESULT, sHolding); break;
+    case 10: Canvas_HoldLeader(fsys, TRUE, FALSE); break;
+    case 11:                                                                           // a: 0 the player steps in / 1 back
+        dirs[0] = a ? sOpposite[sHoldDir] : sHoldDir;
+        Apply(fsys, OBJ_PLAYER, dirs, 1, MOVE_FAST, a ? sHoldDir : sOpposite[sHoldDir]);
+        break;
+    case 13: Canvas_OakFinale(); break;                                               // GymChallenge_GenerateOakFinale
+    case 14: Canvas_GenerateGymTrainer(); break;                                      // a challenger at the player's gym
+    case 15: Canvas_PrepareFamous(a, b, c); break;                                    // a: trainer, b: their average level, c: + levels
+    case 16: Canvas_BufferChallengerName(ctx, a, b); break;                           // a: slot, b: name
+    case 17: {                                                                        // a: a person, put at b, c (the player's height)
+        void *o = Cv_GetObjectById(fsys, a), *pl = Cv_GetObjectById(fsys, OBJ_PLAYER);
+        if (o && pl) Cv_ObjPlace(o, b, Cv_ObjY(pl), c, d);
+        break;
+    }
+    case 18:                                                                          // the ghosts: a girl, b her Scyther
+        if (!Ghosts_Place(fsys, a, b)) return FALSE;
+        return Ghosts_Start(ctx, a, b, TRUE);
+    case 19: return Ghosts_Start(ctx, a, b, FALSE);                                   // (then the script takes them away)
+    case 22: Canvas_CameraTrip(fsys, a, b, FALSE); break;                             // to (a, b), then WaitMovement
+    case 23: Canvas_CameraTrip(fsys, 0, 0, TRUE); break;                              // back
+    case 20: Canvas_BadgeShow(fsys, a); break;                                       // the player's badge (a: their type)
+    case 21: Canvas_BadgeHide(); break;
+    case 12:                                                                          // (after the battle)
+        sChallenger.valid = FALSE;
+        if (sPrizeWas && GuestPrize() != NULL) GuestPrize()->multiplier = sPrizeWas;
+        sPrizeWas = 0;
+        break;
+    }
+    return FALSE;
+}
diff --git a/src/field/canvas_field.c b/src/field/canvas_field.c
new file mode 100644
index 00000000..bf1f11a0
--- /dev/null
+++ b/src/field/canvas_field.c
@@ -0,0 +1,26 @@
+// Pokemon Canvas: the entry to our script commands that live in the field overlay (131), called from
+// script_new_cmds.c by address: it goes first in the overlay (the .init section), at 0x023C8000 (build_rom.sh
+// checks). New field-time engine code goes in src/field and is reached from here.
+#include "../../include/types.h"
+#include "../../include/script.h"
+
+#define CANVAS_CMD_CANDIDATE 112
+BOOL Canvas_CandidateCmd(SCRIPTCONTEXT *ctx, u16 op);
+// CanvasMsg msg: NPCMsg with a 16-bit message id (HeartGold's message commands read or cast it to a byte, and a
+// ported map's bank can hold more than 256 messages: the Pallet gym's does)
+#define CANVAS_CMD_MSG 113
+void LONG_CALL ov01_021EF4DC(SCRIPTCONTEXT *ctx, void *msgData, u16 msg, u8 canSpeedUp, void *unk);
+BOOL LONG_CALL ov01_021EF348(SCRIPTCONTEXT *ctx);
+void LONG_CALL SetupNativeScript(SCRIPTCONTEXT *ctx, BOOL (*fn)(SCRIPTCONTEXT *));
+
+__attribute__((section(".init"))) BOOL Canvas_FieldCmd(SCRIPTCONTEXT *ctx, u8 sw, u16 arg0)
+{
+    switch (sw) {
+    case CANVAS_CMD_CANDIDATE: return Canvas_CandidateCmd(ctx, arg0);
+    case CANVAS_CMD_MSG:
+        ov01_021EF4DC(ctx, ctx->msg_data, arg0, TRUE, NULL);
+        SetupNativeScript(ctx, ov01_021EF348);
+        return TRUE;
+    }
+    return FALSE;
+}
