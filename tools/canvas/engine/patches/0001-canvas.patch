+// From MakeTrainerPokemonParty (field/enemy_party.c): our challenger's party and name, for the trainers that are ours
+BOOL Canvas_MakeChallengerParty(struct BATTLE_PARAM *bp, int num, int heapID)
+{
+    extern u32 gLastPokemonLevelForMoneyCalc;
+    u32 id = bp->trainer_id[num], i;
+    if (id < CANVAS_CHALLENGER_FIRST || id >= CANVAS_CHALLENGER_FIRST + CANVAS_CHALLENGER_COUNT || !sChallenger.valid)
+        return FALSE;
+    TRAINER_DATA *td = &bp->trainer_data[num];
+    struct TrainerMoney *prize = sChallenger.prizeRate != CANVAS_PRIZE_KEEP ? GuestPrize() : NULL;
+    if (prize != NULL) {          // (HeartGold doubles a double battle's prize itself)
+        if (!sPrizeWas) sPrizeWas = prize->multiplier;
+        prize->multiplier = sChallenger.prizeRate / ((bp->fight_type & BATTLE_TYPE_DOUBLES) ? 2 : 1);
+    }
+    td->tr_type = sChallenger.trainerClass;
+    td->poke_count = sChallenger.count;
+    td->aibit = sChallenger.ai;
+    for (i = 0; i < 8; i++) td->name[i] = sChallenger.name[i];
+    PokeParty_Init(bp->poke_party[num], 6);
+    for (i = 0; i < sChallenger.count; i++) {
+        struct PartyPokemon *mon = AllocMonZeroed(heapID);
+        u32 pid = ((u32)gf_rand() << 16) | gf_rand();            // (a random nature and gender: the GBA's)
+        if (sChallenger.kind == CANVAS_CHALLENGER_OAK) {
+            u32 j, ev;
+            PokeParaSetChr(mon, sChallenger.species[i], sChallenger.level[i], sChallenger.iv, sOakTeam[i].nature);
+            for (j = 0; j < 4; j++) SetPartyPokemonMoveAtPos(mon, sOakTeam[i].moves[j], j);
+            for (j = 0; j < 6; j++) { ev = sOakEvs[sOakTeam[i].evs][j]; SetMonData(mon, MON_DATA_HP_EV + j, &ev); }
+        } else
+            PokeParaSet(mon, sChallenger.species[i], sChallenger.level[i], sChallenger.iv, 1, pid, 2, 0);
+        if (sChallenger.item[i]) SetMonData(mon, MON_DATA_HELD_ITEM, &sChallenger.item[i]);
+        RecalcPartyPokemonStats(mon);
+        PokeParty_Add(bp->poke_party[num], mon);
+        sys_FreeMemoryEz(mon);
+        gLastPokemonLevelForMoneyCalc = sChallenger.level[i];
+    }
+    return TRUE;
+}
