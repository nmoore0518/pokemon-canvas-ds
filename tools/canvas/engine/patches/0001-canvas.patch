--- /dev/null
+++ b/include/canvas_items.h
@@ -0,0 +1,20 @@
+#ifndef CANVAS_ITEMS_H
+#define CANVAS_ITEMS_H
+// Pokemon Canvas: the GBA game's items (tools/canvas/build_items.py writes their ids and data). Where they work:
+//  - the Eviolate (HOLD_EFFECT_CANVAS_EVIOLATE): src/individual/CalcBaseDamage.c, with Choice Band
+//  - the type gear: GetTypeEffectiveness (src/battle/other_battle_calculators.c: Guard and Edge), never taken
+//    (CanItemBeRemovedFromSpecies, Bestow), never tossed (their item data)
+//  - the Type Balls: their catch rate in src/individual/CalculateBallShakes.c; the caught Pokemon's ball in
+//    src/pokemon.c (SetBoxMonData: shown as a Poke Ball, the type kept in MON_DATA_UNK_121) and its stat boost
+//    (Canvas_CalcMonStats, which takes the place of HeartGold's CalcMonStats: hooks)
+#include "constants/item.h"
+#include "constants/pokemon.h"
+
+// the Type Balls' (and the gear's) types, in the GBA game's order
+static const u8 sCanvasItemTypes[18] = {
+    TYPE_NORMAL, TYPE_FIGHTING, TYPE_FLYING, TYPE_POISON, TYPE_GROUND, TYPE_ROCK, TYPE_BUG, TYPE_GHOST, TYPE_STEEL,
+    TYPE_FIRE, TYPE_WATER, TYPE_GRASS, TYPE_ELECTRIC, TYPE_PSYCHIC, TYPE_ICE, TYPE_DRAGON, TYPE_DARK, TYPE_FAIRY,
+};
+#define CANVAS_TYPE_BALL_TYPE(item) (sCanvasItemTypes[(item) - ITEM_NORMAL_BALL])
+
+#endif
