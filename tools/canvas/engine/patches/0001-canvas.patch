diff --git a/include/canvas_candidate.h b/include/canvas_candidate.h
new file mode 100644
index 00000000..19cee961
--- /dev/null
+++ b/include/canvas_candidate.h
@@ -0,0 +1,36 @@
+// Pokemon Canvas: the candidacy's state (field/canvas_candidate.c). The code is in the field overlay, which is
+// unloaded for a battle and loaded again after it (its variables start over), so what has to last through the
+// guest's battle - the challenger, the walks, where the leader stands - lives in overlay 129 (canvas_state.c).
+#ifndef CANVAS_CANDIDATE_H
+#define CANVAS_CANDIDATE_H
+#include "types.h"
+
+#define CANVAS_PATH_MAX 60
+#define CANVAS_CHALLENGER_GUEST 0     // a Guest Leader challenger: a random team
+#define CANVAS_CHALLENGER_OAK 1       // Oak, in the finale: his set team
+#define CANVAS_CHALLENGER_TRAINER 2   // a challenger at the player's gym: a random strong team
+#define CANVAS_CHALLENGER_FAMOUS 3    // a famous trainer at the player's gym: their own team, at the player's level
+#define CANVAS_PRIZE_KEEP 0xFF        // (prizeRate: leave the class's prize as it is)
+
+struct CanvasChallenger {
+    u8 valid, count, trainerClass, iv, prizeRate, kind;     // (kind: CANVAS_CHALLENGER_*)
+    u16 species[6], item[6];
+    u8 level[6];
+    u16 name[8];
+    u32 ai;
+    u16 famousId;                 // (FAMOUS: their trainer; their levels move by levelShift)
+    s8 levelShift;
+};
+
+struct CanvasCandidateState {
+    struct CanvasChallenger challenger;
+    u16 prizeWas;
+    u8 guestDir, facingBefore, visitorWalked;
+    u8 walkIn[CANVAS_PATH_MAX + 2], walkOut[CANVAS_PATH_MAX + 2], walkLen;
+    u8 holding, holdDir;
+    u16 holdLeaderId;
+    s16 leaderX, leaderZ, asideX, asideZ;
+};
+
+extern struct CanvasCandidateState gCanvasCandidate;
+#endif
