diff --git a/src/canvas_boulders.c b/src/canvas_boulders.c
new file mode 100644
index 00000000..c4dd4fbf
--- /dev/null
+++ b/src/canvas_boulders.c
@@ -0,0 +1,97 @@
+// Pokemon Canvas: a Strength boulder that comes to rest on a boulder switch or a hole starts the square's script, as
+// the GBA game's Victory Road switches (HandleBoulderActivateVictoryRoadSwitch) and holes (HandleBoulderFallThroughHole)
+// do. Such a square is a coord event whose value is CANVAS_BOULDER_SWITCH.. +15 (the porter writes them so; no var is
+// ever set to one, so walking on one does nothing). The script runs with the boulder as the one talked to.
+// Replaces ov01_021F1ECC (overlay 1), the task that pushes a boulder: the same steps, then that check at the end.
+#include "../include/types.h"
+
+#define CANVAS_BOULDER_SWITCH 0xB0B0
+#define SEQ_SE_DP_UG_023 1574
+
+struct PushEnv {
+    int state;
+    int dir;
+    void *fieldSystem;
+    void *playerAvatar;
+    void *rock;
+};
+
+struct CanvasCoordEvent {
+    u16 scriptId;
+    s16 x;
+    s16 z;
+    u16 w;
+    u16 h;
+    u16 y;
+    u16 val;
+    u16 var;
+};
+
+#define FN(addr, ret, args) ((ret (*) args)((addr) | 1))
+#define TaskManager_GetEnvironment FN(0x02050650, struct PushEnv *, (void *))
+#define PlayerAvatar_GetMapObject FN(0x0205C6DC, void *, (void *))
+#define MapObject_AreBitsSetForMovementScriptInit FN(0x02062108, BOOL, (void *))
+#define PlayerAvatar_CanMove FN(0x0205DE38, BOOL, (void *))                 // sub_0205DE38
+#define MovementAction_ForDirection FN(0x0206234C, u32, (int, u32))         // sub_0206234C
+#define MapObject_SetHeldMovement FN(0x0206214C, void, (void *, u32))
+#define MapObject_IsMovementPaused FN(0x02062198, BOOL, (void *))
+#define MapObject_ClearHeldMovementIfActive FN(0x020621C0, void, (void *))
+#define PushEnv_Free FN(0x021F30F4, void, (struct PushEnv *))                // ov01_021F30F4
+#define Boulder_FallThroughHole FN(0x021F2004, BOOL, (void *, void *, void *))   // ov01_021F2004 (Blackthorn's)
+#define MapObject_GetXCoord FN(0x0205F914, int, (void *))
+#define MapObject_GetZCoord FN(0x0205F934, int, (void *))
+#define Field_GetNumCoordEvents FN(0x0203B73C, u32, (void *))
+#define Field_GetCoordEvents FN(0x0203B744, const struct CanvasCoordEvent *, (void *))
+#define StartScriptFromMenu FN(0x0203FF0C, void, (void *, u16, void *))      // (this task becomes the script's)
+#define PlaySE FN(0x0200604C, void, (u16))
+
+static BOOL Canvas_BoulderOnSwitch(void *taskManager, void *fieldSystem, void *rock)
+{
+    int x = MapObject_GetXCoord(rock), z = MapObject_GetZCoord(rock);
+    const struct CanvasCoordEvent *ev = Field_GetCoordEvents(fieldSystem);
+    u32 n = Field_GetNumCoordEvents(fieldSystem), i;
+    for (i = 0; i < n; i++) {
+        if ((ev[i].val & 0xFFF0) == CANVAS_BOULDER_SWITCH && x >= ev[i].x && x < ev[i].x + ev[i].w && z >= ev[i].z && z < ev[i].z + ev[i].h) {
+            StartScriptFromMenu(taskManager, ev[i].scriptId, rock);
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+BOOL Canvas_PushBoulderTask(void *taskManager)
+{
+    struct PushEnv *env = TaskManager_GetEnvironment(taskManager);
+    void *player = PlayerAvatar_GetMapObject(env->playerAvatar);
+    void *rock = env->rock;
+    void *fieldSystem;
+
+    switch (env->state) {
+    case 0:
+        if (!MapObject_AreBitsSetForMovementScriptInit(rock))
+            return FALSE;
+        if (!MapObject_AreBitsSetForMovementScriptInit(player) && !PlayerAvatar_CanMove(env->playerAvatar))
+            return FALSE;
+        MapObject_SetHeldMovement(rock, MovementAction_ForDirection(env->dir, 8));
+        MapObject_SetHeldMovement(player, MovementAction_ForDirection(env->dir, 0x20));
+        PlaySE(SEQ_SE_DP_UG_023);
+        env->state++;
+        return FALSE;
+    case 1:
+        if (!MapObject_IsMovementPaused(rock) || !MapObject_IsMovementPaused(player))
+            return FALSE;
+        MapObject_ClearHeldMovementIfActive(rock);
+        MapObject_ClearHeldMovementIfActive(player);
+        env->state++;
+        // fall through
+    case 2:
+        fieldSystem = env->fieldSystem;
+        PushEnv_Free(env);
+        if (**(int **)((u8 *)fieldSystem + 0x20) == 0xED)       // (fieldSystem->location->mapId)
+            return Boulder_FallThroughHole(taskManager, fieldSystem, rock);
+        if (Canvas_BoulderOnSwitch(taskManager, fieldSystem, rock))
+            return FALSE;         // (the task goes on as the switch's script)
+        return TRUE;
+    }
+    return FALSE;
+}
diff --git a/src/canvas_flags.c b/src/canvas_flags.c
new file mode 100644
index 00000000..88146d6a
--- /dev/null
+++ b/src/canvas_flags.c
@@ -0,0 +1,70 @@
+// Pokemon Canvas: our own flags and vars, routed through HeartGold's own flag/var functions so every script
+// command, object visibility flag and map-script condition works with them unchanged.
+//   flags 0x2000..0x2FFF -> SAVE_MISC_DATA.canvasFlags      (HeartGold's own: 0..2911; temp flags 0x4000+)
+//   vars  0x5000..0x51FF -> SAVE_MISC_DATA.canvasVars       (HeartGold's own: 0x4000..0x416F)
+// Hooks Save_VarsFlags_GetFlagAddr (0205045C) and Save_VarsFlags_GetVarAddr (020504A4).
+#include "../include/types.h"
+#include "../include/save.h"
+
+#define CANVAS_FLAG_BASE 0x2000
+#define CANVAS_VAR_BASE  0x5000
+#define TEMP_FLAG_BASE   0x4000
+#define VAR_BASE         0x4000
+#define TEMP_FLAGS_RAM   ((u8 *)0x021D4170)   // sTempFlags
+
+struct VarsFlagsLayout {
+    u16 vars[0x170];
+    u8 flags[2912 / 8];
+};
+
+u8 *Canvas_GetFlagAddr(struct VarsFlagsLayout *varsFlags, u16 flagId)
+{
+    if (flagId == 0)
+        return NULL;
+    if (flagId >= CANVAS_FLAG_BASE && flagId < CANVAS_FLAG_BASE + CANVAS_NUM_FLAGS)
+        return &Sav2_Misc_get(SaveBlock2_get())->canvasFlags[(flagId - CANVAS_FLAG_BASE) / 8];
+    if (flagId < TEMP_FLAG_BASE)
+        return &varsFlags->flags[flagId / 8];
+    return &TEMP_FLAGS_RAM[(flagId - TEMP_FLAG_BASE) / 8];
+}
+
+u16 *Canvas_GetVarAddr(struct VarsFlagsLayout *varsFlags, u16 varId)
+{
+    if (varId >= CANVAS_VAR_BASE && varId < CANVAS_VAR_BASE + CANVAS_NUM_VARS)
+        return &Sav2_Misc_get(SaveBlock2_get())->canvasVars[varId - CANVAS_VAR_BASE];
+    return &varsFlags->vars[varId - VAR_BASE];
+}
+
+// Trainer "defeated" flags. HeartGold keeps them at 0x550 + trainer, with room for trainers up to 1043 before they
+// run into its system flags; our trainers (738+, tools/canvas/port/trainers.py) keep theirs in our own flags from
+// CANVAS_TRAINER_FLAGS on. Hooks TrainerFlagCheck/Set/Clear (02040514 / 0204052C / 02040544).
+#define FIRST_CANVAS_TRAINER 738
+#define CANVAS_TRAINER_FLAGS 3072      // our flags 0x2C00.. (room for 1024 trainers)
+
+static u16 Canvas_TrainerFlagId(u32 trainer)
+{
+    if (trainer >= FIRST_CANVAS_TRAINER)
+        return CANVAS_FLAG_BASE + CANVAS_TRAINER_FLAGS + (trainer - FIRST_CANVAS_TRAINER);
+    return 0x550 + trainer;
+}
+
+BOOL Canvas_TrainerFlagCheck(void *saveData, u32 trainer)
+{
+    u16 id = Canvas_TrainerFlagId(trainer);
+    u8 *addr = Canvas_GetFlagAddr(SaveData_GetEventPtr(saveData), id);
+    return addr != NULL && (*addr & (1 << (id % 8))) != 0;
+}
+
+void Canvas_TrainerFlagSet(void *saveData, u32 trainer)
+{
+    u16 id = Canvas_TrainerFlagId(trainer);
+    u8 *addr = Canvas_GetFlagAddr(SaveData_GetEventPtr(saveData), id);
+    if (addr != NULL) *addr |= 1 << (id % 8);
+}
+
+void Canvas_TrainerFlagClear(void *saveData, u32 trainer)
+{
+    u16 id = Canvas_TrainerFlagId(trainer);
+    u8 *addr = Canvas_GetFlagAddr(SaveData_GetEventPtr(saveData), id);
+    if (addr != NULL) *addr &= ~(1 << (id % 8));
+}
diff --git a/src/canvas_map_headers.c b/src/canvas_map_headers.c
new file mode 100644
index 00000000..f73b38b1
--- /dev/null
+++ b/src/canvas_map_headers.c
@@ -0,0 +1,75 @@
+// Pokemon Canvas: maps past HeartGold's 540.
+// HeartGold's map header table sits in the ARM9 and can't grow (hg-engine needs the ARM9 laid out as retail), so
+// headers for our maps live in a/0/2/8 (CODE_ADDON_CANVAS_MAP_HEADERS: u32 count, u32 first id, 24 bytes a map).
+// Every MapHeader_Get... calls MapNumberBoundsCheck(mapId) and then reads sMapHeaders[result]; this replaces it,
+// and for one of our maps copies its header into a spare entry of HeartGold's table (MAP_UNUSED) and returns that.
+#include "../include/types.h"
+#include "../include/save.h"
+#include "../include/constants/file.h"
+#include "../data/canvas_variants.h"     // (tools/canvas/build_rooms.py) CANVAS_VARIANTS: { map, our flag, matrix }
+
+#define RETAIL_MAP_COUNT   540
+#define MAP_NOTHING        1
+#define MAP_HEADER_WINDOW  538          // MAP_UNUSED: never used by HeartGold, kept free by the canvas tools
+#define MAP_HEADER_SIZE    24
+#define MAP_HEADERS_RAM    ((u8 *)0x020F6BE0)   // sMapHeaders
+#define CACHE_SIZE         8
+
+static u16 sCacheId[CACHE_SIZE];
+static u8 sCache[CACHE_SIZE][MAP_HEADER_SIZE];
+static u8 sCacheNext;
+static u32 sTableInfo[2];   // count, first id
+static u32 sReady;          // (this overlay's memory isn't cleared at load: set up on first use)
+#define READY_MAGIC 0x43564D48
+
+// Room variants: a map drawn as its map script first leaves it (a cupboard over the stairs) has a second land for
+// how it is once one of our flags is set; while it's set, the map's header is shown with that land's matrix.
+struct CanvasVariant { u16 map, flag, matrix; };
+static const struct CanvasVariant sVariants[] = { CANVAS_VARIANTS { 0xFFFF, 0, 0 } };
+
+static BOOL Canvas_OurFlagSet(u16 n)
+{
+    return (Sav2_Misc_get(SaveBlock2_get())->canvasFlags[n / 8] >> (n % 8)) & 1;
+}
+
+u32 Canvas_MapNumberBoundsCheck(u32 mapId)
+{
+    u8 *window = MAP_HEADERS_RAM + MAP_HEADER_WINDOW * MAP_HEADER_SIZE;
+    int i, j;
+    for (i = 0; sVariants[i].map != 0xFFFF; i++)
+    {
+        if (sVariants[i].map == mapId && mapId < RETAIL_MAP_COUNT && Canvas_OurFlagSet(sVariants[i].flag))
+        {
+            for (j = 0; j < MAP_HEADER_SIZE; j++)
+                window[j] = MAP_HEADERS_RAM[mapId * MAP_HEADER_SIZE + j];
+            *(u16 *)(window + 4) = sVariants[i].matrix;      // (MapHeader.matrixId)
+            return MAP_HEADER_WINDOW;
+        }
+    }
+    if (mapId < RETAIL_MAP_COUNT)
+        return mapId;
+    if (sReady != READY_MAGIC)
+    {
+        for (i = 0; i < CACHE_SIZE; i++)
+            sCacheId[i] = 0xFFFF;
+        sCacheNext = 0;
+        ReadFromNarcMemberByIdPair(sTableInfo, ARC_CODE_ADDONS, CODE_ADDON_CANVAS_MAP_HEADERS, 0, 8);
+        sReady = READY_MAGIC;
+    }
+    for (i = 0; i < CACHE_SIZE; i++)
+    {
+        if (sCacheId[i] == mapId)
+            goto found;
+    }
+    if (mapId - sTableInfo[1] >= sTableInfo[0])
+        return MAP_NOTHING;
+    i = sCacheNext;
+    sCacheNext = (sCacheNext + 1) % CACHE_SIZE;
+    ReadFromNarcMemberByIdPair(sCache[i], ARC_CODE_ADDONS, CODE_ADDON_CANVAS_MAP_HEADERS,
+                               8 + (mapId - sTableInfo[1]) * MAP_HEADER_SIZE, MAP_HEADER_SIZE);
+    sCacheId[i] = mapId;
+found:
+    for (j = 0; j < MAP_HEADER_SIZE; j++)
+        window[j] = sCache[i][j];
+    return MAP_HEADER_WINDOW;
+}
diff --git a/src/canvas_safari.c b/src/canvas_safari.c
new file mode 100644
index 00000000..a10ca151
--- /dev/null
+++ b/src/canvas_safari.c
@@ -0,0 +1,181 @@
+// Pokemon Canvas: the GBA game's Safari Zone (Fuchsia) on HeartGold's Safari machinery.
+// HeartGold's Safari game (SafariZoneAction 0: its flag, 30 Safari Balls; its Safari battles) is used as it is.
+// Two things are ours, while our flag CANVAS_FLAG_KANTO_SAFARI is set (the porter sets it as the game starts):
+//  - the Pokemon: HeartGold picks a Safari Pokemon from the area it stands in (its own Safari's block layout), so
+//    SafariZoneAreaSet_LoadAreaEncounters, which gives the ten it picks from, is replaced: for Kanto it gives ten of
+//    the one Pokemon the map's own encounter table rolls (the GBA's rates); otherwise it is HeartGold's own, below;
+//  - the steps: the GBA's game ends after 600 steps (HeartGold's has no limit), so FieldSystem_UpdateSafari, run
+//    each step, counts them in HeartGold's own Safari step counter and starts its "time's up" script.
+#include "../include/types.h"
+#include "../include/save.h"
+#include "../include/pokemon.h"
+#include "../include/encounter.h"
+#include "../include/constants/species.h"
+
+#define CANVAS_FLAG_KANTO_SAFARI 4090     // (tools/canvas/port: the same number, KANTO_SAFARI_FLAG)
+#define KANTO_SAFARI_STEPS       600
+#define std_safari_steps_out     8802
+#define std_safari_balls_out     8803
+#define NUM_ENCOUNTERS_SAFARI    10
+#define NUM_SAFARI_ENCOUNTER_TYPES 5
+#define TIMEOFDAY_WILD_MAX       3
+#define NARC_a_2_3_0             232
+
+typedef struct { u32 species; u16 maxLevel; u16 minLevel; } EncounterSlot;
+typedef struct { u16 species; u16 level; } SafariZoneAreaEncounterSlot;
+typedef struct { u8 object1_type, object1_level, object2_type, object2_level; } SafariZoneAreaBonusSlotUnlockConditions;
+typedef struct { u8 levels[4]; u8 count[4]; } SafariZoneObjectLevels;
+typedef struct {
+    SafariZoneAreaEncounterSlot *baseMons;
+    SafariZoneAreaEncounterSlot *bonusMons;
+    SafariZoneAreaBonusSlotUnlockConditions *unlockConditions;
+    int bonusMonsArraySize;
+    u8 numBonusMons;
+} LoadedSafariZoneEncounterData;
+typedef struct { u8 area_no; u8 active_object_count; u8 objects[30][4]; } SafariZoneArea;   // (SAFARIZONE_AREA)
+
+void *LONG_CALL GfGfxLoader_LoadFromNarc(int narcId, int member, BOOL compressed, u32 heapId, BOOL atEnd);
+void LONG_CALL SafariZoneAreaSet_GetObjectsInArea(void *areaSet, int area, SafariZoneObjectLevels *out);
+void *LONG_CALL Save_VarsFlags_Get(void *save);
+BOOL LONG_CALL Save_VarsFlags_CheckSafariSysFlag(void *varsFlags);
+void *LONG_CALL Save_LocalFieldData_Get(void *save);
+u16 *LONG_CALL LocalFieldData_GetSafariBallsCounter(void *fieldData);
+u16 *LONG_CALL LocalFieldData_GetSafariStepsCounter(void *fieldData);
+EncounterData *LONG_CALL MapEvents_GetLoadedEncTable(FieldSystem *fsys);
+void LONG_CALL StartMapSceneScript(FieldSystem *fsys, u16 script, void *obj);
+
+#define sFieldSysPtr (*(FieldSystem **)0x021D4158)
+
+static BOOL Canvas_KantoSafari(void)
+{
+    return (Sav2_Misc_get(SaveBlock2_get())->canvasFlags[CANVAS_FLAG_KANTO_SAFARI / 8] >> (CANVAS_FLAG_KANTO_SAFARI % 8)) & 1;
+}
+
+// the GBA's (and HeartGold's) chances of each slot: land 12, the others 5
+static const u8 sLandRates[12] = { 20, 20, 10, 10, 10, 10, 5, 5, 4, 4, 1, 1 };
+static const u8 sOtherRates[5] = { 60, 30, 5, 4, 1 };
+
+static int Canvas_RollSlot(const u8 *rates, int n)
+{
+    int r = gf_rand() % 100, i;
+    for (i = 0; i < n - 1; i++) {
+        if (r < rates[i])
+            return i;
+        r -= rates[i];
+    }
+    return n - 1;
+}
+
+static void Canvas_KantoSafariSlots(EncounterSlot *ret, int encounterType)
+{
+    EncounterData *enc = MapEvents_GetLoadedEncTable(sFieldSysPtr);
+    u16 species;
+    u8 level;
+    int i;
+    if (encounterType == 0) {
+        i = Canvas_RollSlot(sLandRates, 12);
+        species = enc->landSlots.speciesDay[i];
+        level = enc->landSlots.levels[i];
+    } else {
+        EncounterDataSlot *slots = encounterType == 1 ? enc->surfSlots
+                                 : encounterType == 2 ? enc->oldRodSlots
+                                 : encounterType == 3 ? enc->goodRodSlots : enc->superRodSlots;
+        EncounterDataSlot *s = &slots[Canvas_RollSlot(sOtherRates, 5)];
+        species = s->species;
+        level = s->levelMin + (s->levelMax > s->levelMin ? gf_rand() % (s->levelMax - s->levelMin + 1) : 0);
+    }
+    for (i = 0; i < NUM_ENCOUNTERS_SAFARI; i++) {
+        ret[i].species = species;
+        ret[i].maxLevel = ret[i].minLevel = level;
+    }
+}
+
+// replaces SafariZoneAreaSet_LoadAreaEncounters (0x020974C4): HeartGold's own, but for Kanto's Safari Zone
+EncounterSlot *Canvas_SafariLoadAreaEncounters(void *areaSet, int area, int encounterType, int timeOfDay, u32 heapID)
+{
+    int i, offset;
+    u8 *encDataArc;
+    EncounterSlot *ret;
+    SafariZoneArea *safariZoneArea;
+    LoadedSafariZoneEncounterData *loadedEncData;
+
+    ret = sys_AllocMemoryLo(heapID, NUM_ENCOUNTERS_SAFARI * sizeof(EncounterSlot));
+    if (Canvas_KantoSafari()) {
+        Canvas_KantoSafariSlots(ret, encounterType);
+        return ret;
+    }
+
+    safariZoneArea = &((SafariZoneArea *)areaSet)[area];
+    for (i = 0; i < NUM_ENCOUNTERS_SAFARI; ++i) {
+        ret[i].species = encounterType == 0 ? SPECIES_RATTATA : SPECIES_MAGIKARP;
+        ret[i].maxLevel = ret[i].minLevel = 5;
+    }
+    encDataArc = GfGfxLoader_LoadFromNarc(NARC_a_2_3_0, safariZoneArea->area_no, FALSE, heapID, TRUE);
+    if (encDataArc == NULL)
+        return ret;
+
+    loadedEncData = sys_AllocMemoryLo(heapID, NUM_SAFARI_ENCOUNTER_TYPES * sizeof(LoadedSafariZoneEncounterData));
+    offset = 8;
+    for (i = 0; i < NUM_SAFARI_ENCOUNTER_TYPES; ++i) {
+        loadedEncData[i].baseMons = (SafariZoneAreaEncounterSlot *)&encDataArc[offset];
+        offset += TIMEOFDAY_WILD_MAX * NUM_ENCOUNTERS_SAFARI * sizeof(SafariZoneAreaEncounterSlot);
+        loadedEncData[i].bonusMons = (SafariZoneAreaEncounterSlot *)&encDataArc[offset];
+        loadedEncData[i].numBonusMons = encDataArc[i];
+        loadedEncData[i].bonusMonsArraySize = loadedEncData[i].numBonusMons * sizeof(SafariZoneAreaEncounterSlot);
+        offset += TIMEOFDAY_WILD_MAX * loadedEncData[i].bonusMonsArraySize;
+        loadedEncData[i].unlockConditions = (SafariZoneAreaBonusSlotUnlockConditions *)&encDataArc[offset];
+        offset += loadedEncData[i].numBonusMons * sizeof(SafariZoneAreaBonusSlotUnlockConditions);
+    }
+    if (loadedEncData[1].numBonusMons == 0 && encounterType > 0) {
+        sys_FreeMemoryEz(loadedEncData);
+        sys_FreeMemoryEz(encDataArc);
+        return ret;
+    }
+    offset = NUM_ENCOUNTERS_SAFARI * timeOfDay;
+    for (i = 0; i < NUM_ENCOUNTERS_SAFARI; ++i) {
+        SafariZoneAreaEncounterSlot *slot = &loadedEncData[encounterType].baseMons[offset + i];
+        ret[i].species = slot->species;
+        ret[i].maxLevel = ret[i].minLevel = slot->level;
+    }
+
+    SafariZoneObjectLevels areaObjects;
+    u8 numBonusMons = 0;
+    SafariZoneAreaSet_GetObjectsInArea(areaSet, area, &areaObjects);
+    for (i = 0; i < loadedEncData[encounterType].numBonusMons; ++i) {
+        int idx;
+        SafariZoneAreaBonusSlotUnlockConditions *unlock = &loadedEncData[encounterType].unlockConditions[i];
+        if (areaObjects.levels[unlock->object1_type - 1] < unlock->object1_level)
+            continue;
+        if (unlock->object2_type != 0 && areaObjects.levels[unlock->object2_type - 1] < unlock->object2_level)
+            continue;
+        idx = loadedEncData[encounterType].numBonusMons * timeOfDay + i;
+        ret[numBonusMons].species = loadedEncData[encounterType].bonusMons[idx].species;
+        ret[numBonusMons].maxLevel = ret[numBonusMons].minLevel = loadedEncData[encounterType].bonusMons[idx].level;
+        if (++numBonusMons > NUM_ENCOUNTERS_SAFARI - 1)
+            break;
+    }
+    sys_FreeMemoryEz(loadedEncData);
+    sys_FreeMemoryEz(encDataArc);
+    return ret;
+}
+
+// replaces FieldSystem_UpdateSafari (ov01_021E79CC): HeartGold's ball check, and for Kanto the GBA's 600 steps
+BOOL Canvas_UpdateSafari(FieldSystem *fsys)
+{
+    void *fieldData;
+    if (!Save_VarsFlags_CheckSafariSysFlag(Save_VarsFlags_Get(fsys->savedata)))
+        return FALSE;
+    fieldData = Save_LocalFieldData_Get(fsys->savedata);
+    if (*LocalFieldData_GetSafariBallsCounter(fieldData) == 0) {
+        StartMapSceneScript(fsys, std_safari_balls_out, NULL);
+        return TRUE;
+    }
+    if (Canvas_KantoSafari()) {
+        u16 *steps = LocalFieldData_GetSafariStepsCounter(fieldData);
+        if (++*steps >= KANTO_SAFARI_STEPS) {
+            StartMapSceneScript(fsys, std_safari_steps_out, NULL);
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
