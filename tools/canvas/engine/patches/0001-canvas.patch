+// Pokemon Canvas: the Type Ball's stat boost (the GBA game's GetTypeBallStatBoosts): a Pokemon of the ball's type
+// has its lowest base stat (all of them, if several tie) x1.5. -> a mask of STAT_HP..STAT_SPECIAL_DEFENSE
+static u32 Canvas_TypeBallBoosts(struct PartyPokemon *mon, u32 species, u32 form)
+{
+    u32 type = GetMonData(mon, MON_DATA_UNK_121, NULL), i, base, lowest = 0xFFFF, mask = 0;
+    if (type == 0 || type > NELEMS(sCanvasItemTypes)) return 0;
+    type--;
+    if (PokeFormNoPersonalParaGet(species, form, PERSONAL_TYPE_1) != type && PokeFormNoPersonalParaGet(species, form, PERSONAL_TYPE_2) != type) return 0;
+    for (i = STAT_HP; i <= STAT_SPECIAL_DEFENSE; i++) {
+        if (i == STAT_HP && species == SPECIES_SHEDINJA) continue;      // (its 1 HP never changes)
+        base = PokeFormNoPersonalParaGet(species, form, PERSONAL_BASE_HP + i);
+        if (base < lowest) { lowest = base; mask = 0; }
+        if (base == lowest) mask |= 1 << i;
+    }
+    return mask;
+}
+
+// Pokemon Canvas: HeartGold's CalcMonStats (hooks: it takes its place), with the Type Ball's boost
+BOOL LONG_CALL AcquireMonLock(struct PartyPokemon *mon);
+u16 ModifyStatByNature(u32 nature, u16 n, u8 statIndex);
+BOOL LONG_CALL ReleaseMonLock(struct PartyPokemon *mon, BOOL decry);
+void Canvas_CalcMonStats(struct PartyPokemon *mon)
+{
+    BOOL decry = AcquireMonLock(mon);
+    int level = GetMonData(mon, MON_DATA_LEVEL, NULL), maxHp = GetMonData(mon, MON_DATA_MAXHP, NULL);
+    int hp = GetMonData(mon, MON_DATA_HP, NULL), species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+    int form = GetMonData(mon, MON_DATA_FORM, NULL), i, newMaxHp = 0;
+    u32 boosts = Canvas_TypeBallBoosts(mon, species, form);
+
+    for (i = STAT_HP; i <= STAT_SPECIAL_DEFENSE; i++) {
+        int base = PokeFormNoPersonalParaGet(species, form, PERSONAL_BASE_HP + i);
+        int iv = GetMonData(mon, MON_DATA_HP_IV + i, NULL), ev = GetMonData(mon, MON_DATA_HP_EV + i, NULL);
+        int stat = (base * 2 + iv + ev / 4) * level / 100;
+        if (i == STAT_HP) {
+            stat = species == SPECIES_SHEDINJA ? 1 : stat + level + 10;
+        } else {
+            stat = ModifyStatByNature((u32)mon, (u16)(stat + 5), i);     // (the Pokemon: hg-engine's mints)
+        }
+        if (boosts & (1 << i)) stat = stat * 3 / 2;
+        SetMonData(mon, MON_DATA_MAXHP + i, &stat);
+        if (i == STAT_HP) newMaxHp = stat;
+    }
+
+    if (hp != 0 || maxHp == 0) {
+        if (species == SPECIES_SHEDINJA) {
+            hp = 1;
+        } else if (hp == 0) {
+            hp = newMaxHp;
+        } else if (newMaxHp - maxHp < 0) {
+            if (hp > newMaxHp) hp = newMaxHp;
+        } else {
+            hp += newMaxHp - maxHp;
+        }
+    }
+    if (hp != 0) {
+        SetMonData(mon, MON_DATA_HP, &hp);
+    }
+    ReleaseMonLock(mon, decry);
+}
