@@ -23,6 +37,35 @@ BOOL Script_RunNewCmd(SCRIPTCONTEXT *ctx)
 #endif
         break;
 
+    // Pokemon Canvas: our flags and vars (in the misc save data), and our specials
+    case CANVAS_CMD_FLAG_SET:
+    case CANVAS_CMD_FLAG_CLEAR:
+    case CANVAS_CMD_FLAG_CHECK:
+    case CANVAS_CMD_VAR_SET:
+    case CANVAS_CMD_VAR_GET:
+    case CANVAS_CMD_VAR_ADD:
+        return Canvas_RunCmd(ctx, sw, arg0);
+
+    case CANVAS_CMD_BUFFER_MSG: {
+        MessageFormat **fmt = FieldSysGetAttrAddr(ctx->fsys, SCRIPTENV_MSGFMT);
+        String *str = NewString_ReadMsgData(ctx->msg_data, GetScriptVar(ScriptReadHalfword(ctx)));
+        SetStringAsPlaceholder(*fmt, arg0, str, NULL);
+        String_Delete(str);
+        return FALSE;
+    }
+
+    case CANVAS_CMD_MART: {
+        u16 items[65];
+        u32 i, n = arg0 > 64 ? 64 : arg0;
+        for (i = 0; i < arg0; i++) {
+            u16 item = ScriptReadHalfword(ctx);
+            if (i < n) items[i] = item;
+        }
+        items[n] = 0xFFFF;
+        InitMartUI(ctx->taskman, ctx->fsys, items, 0, 0, 0, 0);
+        return TRUE;
+    }
+
     default:
         break;
     }
@@ -30,6 +73,40 @@ BOOL Script_RunNewCmd(SCRIPTCONTEXT *ctx)
