+static BOOL Canvas_Task_GameClear(TaskManager *taskman)
+{
+    FieldSystem *fsys = taskman->fieldSystem;
+    struct CanvasGameClear *env = taskman->env;
+    switch (taskman->state) {
+    case 0:
+        if (env->doCredits) {
+            Sound_SetMasterVolume(127);
+            Credits_LaunchApp(fsys, &env->credits);
+            taskman->state = 3;
+        } else {
+            RegisterHallOfFame_LaunchApp(fsys, &env->hof);
+            taskman->state = 1;
+        }
+        break;
+    case 1:
+        if (!FieldSystem_ApplicationIsRunning(fsys)) {
+            HealParty(SaveArray_Party_Get(fsys->savedata));
+            SaveGameNormal(fsys->savedata);
+            AddHallOfFameEntry(fsys, env->gameCleared);
+            sys_FreeMemoryEz(env);
+            return TRUE;
+        }
+        break;
+    case 3:
+        if (!FieldSystem_ApplicationIsRunning(fsys)) {
+            OS_ResetSystem(0);
+            return TRUE;
+        }
+        break;
+    }
+    return FALSE;
+}
+
+static void Canvas_StartGameClear(FieldSystem *fsys, BOOL credits)
+{
+    void *save = fsys->savedata, *varsFlags = Save_VarsFlags_Get(save), *profile = Save_PlayerData_GetProfile(save);
+    void *fieldData = Save_LocalFieldData_Get(save);
+    struct CanvasGameClear *env = sys_AllocMemory(32 /* HEAP_ID_FIELD3 */, sizeof(struct CanvasGameClear));
+    env->gameCleared = CheckGameClearFlag(varsFlags);
+    env->doCredits = credits;
+    env->hof.profile = profile;
+    env->hof.party = SaveArray_Party_Get(save);
+    env->hof.igt = Save_PlayerData_GetIGTAddr(save);
+    env->credits.gender = PlayerProfile_GetTrainerGender(profile);
+    env->credits.gameCleared = env->gameCleared;
+    if (!credits) {
+        if (!env->gameCleared)
+            FieldSystem_SetGameClearTime(fsys);
+        Location_SetToPlayerRoom(LocalFieldData_GetDynamicWarp(fieldData));      // (wake up at home: Canvas's Pallet)
+        Location_SetToOutsidePlayerHome(LocalFieldData_GetSpecialSpawnWarpPtr(fieldData));
+        SetFlag966(varsFlags);
+        SetGameClearFlag(varsFlags);
+        PlayerProfile_SetGameClearFlag(profile);
+        GameStats_Inc(Save_GameStats_Get(save), 74 /* GAME_STAT_LEAGUE_WINS */);
+    }
+    TaskManager_Call(fsys->taskman, Canvas_Task_GameClear, env);
+}
