+// From the end of MakeTrainerPokemonParty (field/enemy_party.c): a famous challenger's team at the player's level
+void Canvas_AfterTrainerParty(struct BATTLE_PARAM *bp, int num)
+{
+    u32 i, n;
+    if (!sChallenger.valid || sChallenger.kind != CANVAS_CHALLENGER_FAMOUS || bp->trainer_id[num] != sChallenger.famousId)
+        return;
+    struct TrainerMoney *prize = GuestPrize();
+    bp->trainer_data[num].aibit = sCanvasTierAI[PRACTICE_TIERS - 1];
+    n = PokeParty_GetPokeCount(bp->poke_party[num]);
+    for (i = 0; i < n; i++) {
+        struct PartyPokemon *mon = Party_GetMonByIndex(bp->poke_party[num], i);
+        s32 level = (s32)GetMonData(mon, MON_DATA_LEVEL, NULL) + sChallenger.levelShift;
+        u32 species = GetMonData(mon, MON_DATA_SPECIES, NULL), exp;
+        if (level < 2) level = 2;
+        if (level > 100) level = 100;
+        exp = PokeLevelExpGet(species, level);
+        SetMonData(mon, MON_DATA_EXPERIENCE, &exp);
+        SetMonData(mon, MON_DATA_LEVEL, &level);
+        RecalcPartyPokemonStats(mon);
+    }
+    (void)prize;
+}
