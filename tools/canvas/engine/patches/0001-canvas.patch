-// TODO: Refactor this function
+static int GetTypeEffectivenessInternal(struct BattleSystem *bw, struct BattleStruct *sp, int attack_client, int defence_client, int move_type, u32 *flag);
+
+// Pokemon Canvas: the GBA game's type gear (include/canvas_items.h), on top of the type chart. Neither is used up.
+//  - a Type Edge (attacker): a damaging move the chart would resist or block hits for normal damage instead (blocks
+//    by abilities and items - Levitate, Wonder Guard, an Air Balloon - are checked elsewhere and still stand)
+//  - a Type Guard (defender): a super-effective hit does normal damage instead
 int LONG_CALL GetTypeEffectiveness(struct BattleSystem *bw, struct BattleStruct *sp, int attack_client, int defence_client, int move_type, u32 *flag)
+{
+    int ret = GetTypeEffectivenessInternal(bw, sp, attack_client, defence_client, move_type, flag);
+    if (sp->current_move_index == MOVE_STRUGGLE || sp->moveTbl[sp->current_move_index].power == 0) {
+        return ret;
+    }
+    if (ret < TYPE_MUL_NORMAL && HeldItemHoldEffectGet(sp, attack_client) == HOLD_EFFECT_CANVAS_TYPE_EDGE) {
+        *flag &= ~(MOVE_STATUS_NOT_VERY_EFFECTIVE | MOVE_STATUS_NO_EFFECT);
+        ret = TYPE_MUL_NORMAL;
