+// A name of ours (0-63 male, 64+ female) into a string slot (the gym statue's list, the announcer)
+static void Canvas_BufferChallengerName(SCRIPTCONTEXT *ctx, u32 slot, u32 nameIdx)
+{
+    const u8 *name = nameIdx >= 64 ? sCanvasFemaleNames[(nameIdx - 64) % NELEMS(sCanvasFemaleNames)]
+                                   : sCanvasMaleNames[nameIdx % NELEMS(sCanvasMaleNames)];
+    u16 buf[8];
+    u32 i;
+    for (i = 0; i < 7 && name[i]; i++) buf[i] = name[i] >= 'a' ? 0x145 + name[i] - 'a' : 0x12B + name[i] - 'A';
+    buf[i] = 0xFFFF;
+    String *str = String_New(8, HEAP_ID_FIELD1);
+    CopyU16ArrayToString(str, buf);
+    SetStringAsPlaceholder(*(MessageFormat **)Cv_SysAttr(ctx->fsys, SCRIPTENV_MSGFMT), slot, str, NULL);
+    String_Delete(str);
+}
