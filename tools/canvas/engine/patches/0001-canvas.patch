diff --git a/src/field/canvas_badge.c b/src/field/canvas_badge.c
new file mode 100644
index 00000000..f6acc1d6
--- /dev/null
+++ b/src/field/canvas_badge.c
@@ -0,0 +1,73 @@
+// Pokemon Canvas: the player's own gym badge on screen when it's awarded (the GBA's src/gym_badge.c,
+// GymBadge_ShowIcon / HideIcon): a framed window above the message box with the badge of the player's type, its
+// 32x32 picture doubled. Data: data/canvas_badges.h (tools/canvas/build_badges.py). Reached by CanvasCandidate
+// 20 type / 21 (field/canvas_candidate.c).
+#include "../../include/types.h"
+#include "../../include/script.h"
+#include "../../include/pokemon.h"
+#include "../../data/canvas_badges.h"
+
+#define FN(addr, ret, args) ((ret (*) args)((addr) | 1))
+#define Cv_AllocWindows FN(0x0201D39C, void *, (u32, s32))
+#define Cv_InitWindow FN(0x0201D3C4, void, (void *))
+#define Cv_AddWindow FN(0x0201D40C, void, (void *, void *, u8, u8, u8, u8, u8, u8, u16))     // AddWindowParameterized
+#define Cv_RemoveWindow FN(0x0201D520, void, (void *))
+#define Cv_CopyWindowToVram FN(0x0201D578, void, (void *))
+#define Cv_LoadPltt FN(0x0201C260, void, (u32, const void *, u16, u16))                     // BG_LoadPlttData
+#define Cv_LoadFrame FN(0x0200E3DC, void, (void *, u32, u16, u8, u8, u32))                  // LoadUserFrameGfx1
+#define Cv_DrawFrame FN(0x0200E580, void, (void *, BOOL, u16, u8))                          // DrawFrameAndWindow1
+#define Cv_ClearFrame FN(0x0200E9BC, void, (void *, BOOL))                                  // ClearFrameAndWindow2
+#define Cv_Free FN(0x0201AB0C, void, (void *))
+
+#define BG_MAIN_3 3
+#define HEAP_ID_FIELD1 4
+#define FRAME_TILE 0x3D9        // (the picture window's frame, as HeartGold's Pokemon picture has it)
+#define FRAME_PAL 11
+#define BADGE_TILE 0x2C0        // (after the message box's tiles)
+#define BADGE_PAL 14
+#define BADGE_X 12
+#define BADGE_Y 6
+#define BADGE_W 8               // tiles: the 32x32 picture doubled
+
+struct CvWindow { void *bgConfig; u8 bgId, left, top, width, height, palette; u16 baseTile; void *pixels; };
+static struct CvWindow *sBadgeWindow;
+
+// the 32x32 picture's pixel (x, y) (tiles of 8x8, 4 bits a pixel, row by row)
+static u32 Pixel(const u8 *tiles, u32 x, u32 y)
+{
+    u8 b = tiles[((y >> 3) * 4 + (x >> 3)) * 32 + (y & 7) * 4 + ((x & 7) >> 1)];
+    return (x & 1) ? b >> 4 : b & 15;
+}
+
+void Canvas_BadgeHide(void)
+{
+    if (sBadgeWindow == NULL) return;
+    Cv_ClearFrame(sBadgeWindow, FALSE);
+    Cv_RemoveWindow(sBadgeWindow);
+    Cv_Free(sBadgeWindow);
+    sBadgeWindow = NULL;
+}
+
+void Canvas_BadgeShow(FieldSystem *fsys, u32 type)
+{
+    const u8 *tiles;
+    u8 *out;
+    u32 x, y;
+    if (type >= NELEMS(sCanvasBadgeTiles)) type = 0;
+    Canvas_BadgeHide();
+    tiles = sCanvasBadgeTiles[type];
+    sBadgeWindow = Cv_AllocWindows(HEAP_ID_FIELD1, 1);
+    Cv_InitWindow(sBadgeWindow);
+    Cv_AddWindow(fsys->bg_config, sBadgeWindow, BG_MAIN_3, BADGE_X, BADGE_Y, BADGE_W, BADGE_W, BADGE_PAL, BADGE_TILE);
+    Cv_LoadPltt(0, sCanvasBadgePals[type], 32, BADGE_PAL * 32);              // (GF_PAL_LOCATION_MAIN_BG)
+    Cv_LoadFrame(fsys->bg_config, BG_MAIN_3, FRAME_TILE, FRAME_PAL, 0, HEAP_ID_FIELD1);
+    out = sBadgeWindow->pixels;
+    for (y = 0; y < BADGE_W * 8; y++) {
+        for (x = 0; x < BADGE_W * 8; x += 2) {
+            u32 a = Pixel(tiles, x >> 1, y >> 1);         // (both halves of a byte are one source pixel, doubled)
+            out[((y >> 3) * BADGE_W + (x >> 3)) * 32 + (y & 7) * 4 + ((x & 7) >> 1)] = a | (a << 4);
+        }
+    }
+    Cv_DrawFrame(sBadgeWindow, FALSE, FRAME_TILE, FRAME_PAL);
+    Cv_CopyWindowToVram(sBadgeWindow);
+}
diff --git a/src/field/canvas_candidate.c b/src/field/canvas_candidate.c
new file mode 100644
index 00000000..78bf527c
--- /dev/null
+++ b/src/field/canvas_candidate.c
@@ -0,0 +1,749 @@
+// Pokemon Canvas: the GBA game's candidacy (its src/gym_candidate.c, src/gym_challenge.c): after a badge the leader
+// asks the player to hold their gym against one or two challengers ("Guest Leader" battles).
+//  - the challengers are built at the time (GymChallenge_GenerateGuest: a random class and name, a team of any type
+//    from the first three generations and the new eeveelutions, by the leader's tier), into the trainer the script
+//    battles (CANVAS_CHALLENGER_FIRST..: one a defeat line), whose party and name MakeTrainerPokemonParty takes here;
+//  - the visitors (the challenger, the mentor) walk in from the map's door to the player by a search over the map,
+//    or appear beside them; the player takes the leader's spot while the leader watches from aside.
+// Data: data/canvas_challengers.h (tools/canvas/port/challengers.py). Command CanvasCandidate (script_new_cmds.c).
+#include "../../include/types.h"
+#include "../../include/battle.h"
+#include "../../include/pokemon.h"
+#include "../../include/save.h"
+#include "../../include/script.h"
+#include "../../include/trainer_data.h"
+#include "../../include/constants/species.h"
+#include "../../include/constants/item.h"
+#include "../../include/constants/trainerclass.h"
+#include "../../include/constants/moves.h"
+#include "../../include/constants/pokemon.h"
+#include "../../include/canvas_candidate.h"
+#include "../../include/message.h"
+
+#define CANVAS_CHALLENGER_FIRST 1470        // (trainers.py: TRAINER_CANVAS_GUEST_0..)
+#define CANVAS_CHALLENGER_COUNT 32
+
+struct CanvasChallengerClass { u8 trainerClass; u8 female; };
+// the pool, a byte a species (Bulbasaur to Deoxys, then our eeveelutions after Pecharunt): its first type (bits 0-4,
+// POOL_LEGENDARY for one never picked), how many times it has evolved (5-6), whether it evolves (7)
+#define POOL_TYPE(b) ((b) & 0x1F)
+#define POOL_STAGE(b) (((b) >> 5) & 3)
+#define POOL_EVOLVES(b) ((b) >> 7)
+#define POOL_LEGENDARY 0x1F
+#define POOL_GEN3 386
+#define POOL_SPECIES(i) ((i) < POOL_GEN3 ? (i) + 1 : 1076 + (i) - POOL_GEN3)
+#include "../../data/canvas_challengers.h"
+
+#define FN(addr, ret, args) ((ret (*) args)((addr) | 1))
+#define Cv_Heap_Alloc FN(0x0201AA8C, void *, (u32, u32))
+#define Cv_Heap_Free FN(0x0201AB0C, void, (void *))
+#define Cv_GetObjectById FN(0x02041C70, void *, (FieldSystem *, u16))             // sub_02041C70 (0xFF: the player)
+#define Cv_GetObjectAt FN(0x0205FB58, void *, (void *, u32, u32, BOOL))         // MapObjectManager_GetFirstObjectWithXAndZ
+#define Cv_Blocked FN(0x020548C0, BOOL, (FieldSystem *, int, int))              // sub_020548C0: the square's collision
+#define Cv_ObjX FN(0x0205F914, u32, (void *))
+#define Cv_ObjZ FN(0x0205F934, u32, (void *))
+#define Cv_ObjY FN(0x0205F924, s32, (void *))
+#define Cv_ObjFace FN(0x0205F290, void, (void *, u32))                          // MapObject_SetFacingDirection
+#define Cv_ObjFacing FN(0x0205F2A8, u32, (void *))                              // MapObject_GetFacingDirection
+#define Cv_ObjSetVisible FN(0x0205F690, void, (void *, BOOL))                    // (TRUE: hidden)
+#define Cv_ObjPlace FN(0x0205FC2C, void, (void *, u32, u32, u32, u32))          // MapObject_SetPositionFromXYZAndDirection
+#define Cv_Warp FN(0x0203B6E8, const struct CvWarp *, (FieldSystem *, u32))     // Field_GetWarpEventI
+#define Cv_MovementCreate FN(0x02062214, void *, (void *, void *))              // EventObjectMovementMan_Create
+#define Cv_MovementSchedule FN(0x02041CC4, void, (FieldSystem *, void *, void *)) // _ScheduleObjectEventMovement
+#define Cv_SysAttr FN(0x020402F0, void *, (FieldSystem *, int))                 // FieldSysGetAttrAddr
+#define SCRIPTENV_NUM_ACTIVE_MOVEMENT 4
+#define HEAP_ID_FIELD1 4
+#define OBJ_PLAYER 0xFF
+#define VAR_RESULT 0x800C
+#define VAR_LAST_TALKED 0x800D      // (VAR_SPECIAL_LAST_TALKED)
+
+struct CvWarp { u16 x; u16 z; u16 header; u16 anchor; u32 y; };
+struct CvMove { u16 command; u16 length; };
+enum { DIR_N, DIR_S, DIR_W, DIR_E };
+#define MOVE_FACE 0
+#define MOVE_WALK 12
+#define MOVE_FAST 16
+#define MOVE_END 254
+static const s8 sDx[] = {0, 0, -1, 1}, sDz[] = {-1, 1, 0, 0};
+static const u8 sOpposite[] = {DIR_S, DIR_N, DIR_E, DIR_W};
+
+// ---------------------------------------------------------------- the challenger
+#define PRACTICE_TIERS 3
+static const u8 sTierIv[PRACTICE_TIERS] = {5, 16, 31};          // (sPracticeTiers: iv, held item chance)
+static const u8 sTierItemChance[PRACTICE_TIERS] = {0, 20, 60};
+static const s8 sLevelSpread[7][6] = {{0}, {0}, {-1, 1}, {-1, 0, 1}, {-1, 0, 0, 1}, {-2, -1, 0, 1, 2}, {-2, -1, 0, 0, 1, 2}};
+
+// (what lasts through the battle is in overlay 129: include/canvas_candidate.h)
+#define sChallenger gCanvasCandidate.challenger
+#define sPrizeWas gCanvasCandidate.prizeWas
+#define sGuestDir gCanvasCandidate.guestDir
+#define sFacingBefore gCanvasCandidate.facingBefore
+#define sVisitorWalked gCanvasCandidate.visitorWalked
+#define sWalkIn gCanvasCandidate.walkIn
+#define sWalkOut gCanvasCandidate.walkOut
+#define sWalkLen gCanvasCandidate.walkLen
+#define sHolding gCanvasCandidate.holding
+#define sHoldDir gCanvasCandidate.holdDir
+#define sHoldLeaderId gCanvasCandidate.holdLeaderId
+#define sLeaderX gCanvasCandidate.leaderX
+#define sLeaderZ gCanvasCandidate.leaderZ
+#define sAsideX gCanvasCandidate.asideX
+#define sAsideZ gCanvasCandidate.asideZ
+
+// The prize: a Gym Leader's (GYM_GUEST_PRIZE_RATE a level, doubled the first time: the GBA's Cmd_getmoneyreward).
+// HeartGold pays by the class in the trainer's data (our trainers': GUEST_PRIZE_CLASS), so that class's rate in
+// hg-engine's table is the guest's for the battle, and put back after it
+#define GUEST_PRIZE_RATE 25
+#define GUEST_PRIZE_CLASS TRAINERCLASS_ACE_TRAINER_M_GS
+struct TrainerMoney { u16 class; u16 multiplier; };
+extern struct TrainerMoney PrizeMoney[];
+static struct TrainerMoney *GuestPrize(void)
+{
+    u32 i;
+    for (i = 0; i < 300; i++)
+        if (PrizeMoney[i].class == GUEST_PRIZE_CLASS) return &PrizeMoney[i];
+    return NULL;
+}
+
+struct Party *LONG_CALL SaveArray_Party_Get(void *saveData);
+int LONG_CALL PokeParty_GetPokeCount(struct Party *party);
+
+static u32 Rand(u32 n) { return n ? gf_rand() % n : 0; }
+
+u32 Canvas_PlayerAverageLevel(void)
+{
+    struct Party *party = SaveArray_Party_Get(SaveBlock2_get());
+    int n = PokeParty_GetPokeCount(party), i, count = 0, total = 0;
+    for (i = 0; i < n; i++) {
+        struct PartyPokemon *mon = Party_GetMonByIndex(party, i);
+        if (GetMonData(mon, MON_DATA_SPECIES, NULL) == 0 || GetMonData(mon, MON_DATA_IS_EGG, NULL))
+            continue;
+        total += GetMonData(mon, MON_DATA_LEVEL, NULL);
+        count++;
+    }
+    return count ? (total + count / 2) / count : 50;
+}
+
+static u32 ClampLevel(s32 level) { return level < 1 ? 1 : level > 100 ? 100 : level; }
+
+// The GBA's PracticePreference: 0 = what the tier is about, 1 = also fine, 2 = only if there's nothing else
+static u32 Preference(u8 m, u32 tier)
+{
+    if (tier == 0) return POOL_STAGE(m) == 0 ? 0 : (POOL_STAGE(m) == 1 ? 1 : 2);
+    if (tier == 1) return POOL_STAGE(m) == 1 ? 0 : (POOL_STAGE(m) == 0 ? 1 : 2);
+    return !POOL_EVOLVES(m) ? 0 : (POOL_STAGE(m) >= 1 ? 1 : 2);
+}
+
+// The GBA's BuildTeam: a team of a type (or any: 0xFF), no legendaries, no two alike, by the tier's preference
+static u32 BuildTeam(u32 tier, u32 type, u32 level, u32 count)
+{
+    u16 *lists[3];
+    u32 counts[3] = {0, 0, 0}, i, k, n, total;
+    s8 spread[6];
+    for (k = 0; k < 3; k++)
+        lists[k] = sys_AllocMemory(HEAP_ID_FIELD1, NELEMS(sCanvasPool) * sizeof(u16));
+    for (i = 0; i < NELEMS(sCanvasPool); i++) {
+        u8 m = sCanvasPool[i];
+        if (POOL_TYPE(m) == POOL_LEGENDARY || (type != 0xFF && POOL_TYPE(m) != type))
+            continue;
+        k = Preference(m, tier);
+        lists[k][counts[k]++] = i;
+    }
+    total = counts[0] + counts[1] + counts[2];
+    n = count ? (count > 6 ? 6 : count) : 3 + Rand(3);
+    if (n > total) n = total;
+    for (i = 0; i < 6; i++) spread[i] = sLevelSpread[n][i];
+    for (i = n - 1; i > 0 && n > 0; i--) {            // (ShuffleLevels)
+        u32 j = Rand(i + 1);
+        s8 t = spread[i]; spread[i] = spread[j]; spread[j] = t;
+    }
+    for (i = 0; i < n; i++) {
+        u32 order[3] = {0, 1, 2}, pick = 0;
+        if (tier != 2 && Rand(3) == 0) { order[0] = 1; order[1] = 0; }     // (the earlier forms mix now and then)
+        for (k = 0; k < 3; k++) {
+            u32 *c = &counts[order[k]];
+            if (*c) {
+                u16 *list = lists[order[k]];
+                u32 j = Rand(*c);
+                pick = list[j];
+                list[j] = list[--*c];
+                break;
+            }
+        }
+        sChallenger.species[i] = POOL_SPECIES(pick);
+        sChallenger.level[i] = ClampLevel((s32)level + spread[i]);
+        sChallenger.item[i] = Rand(100) < sTierItemChance[tier] ? sCanvasHeldItems[Rand(NELEMS(sCanvasHeldItems))] : 0;
+    }
+    for (k = 0; k < 3; k++)
+        sys_FreeMemoryEz(lists[k]);
+    return n;
+}
+
+// GymChallenge_GenerateGuest(baseLevel, partySize, tier, repeat) -> the class picked (the porter gives it its look)
+static u32 Canvas_GenerateGuest(u32 baseLevel, u32 partySize, u32 tier, BOOL repeat)
+{
+    u32 cls = Rand(NELEMS(sCanvasClasses)), i;
+    const u8 *name = sCanvasClasses[cls].female ? sCanvasFemaleNames[Rand(NELEMS(sCanvasFemaleNames))]
+                                                 : sCanvasMaleNames[Rand(NELEMS(sCanvasMaleNames))];
+    s32 avg = Canvas_PlayerAverageLevel(), level = (s32)baseLevel > avg - 3 ? (s32)baseLevel : avg - 3, n;
+    if (repeat) {      // (a stand-in shift after the approval: one at the player's level, more evolved as they grow)
+        u32 t = avg >= 40 ? 2 : avg >= 25 ? 1 : 0;
+        level = avg - 2 + (s32)Rand(6);
+        if (level < 5) level = 5;
+        if (level > 100) level = 100;
+        if (tier < t) tier = t;
+    }
+    if (tier >= PRACTICE_TIERS) tier = PRACTICE_TIERS - 1;
+    sChallenger.trainerClass = sCanvasClasses[cls].trainerClass;
+    for (i = 0; i < 7 && name[i]; i++)        // (ASCII letters -> HeartGold's: A 0x12B, a 0x145)
+        sChallenger.name[i] = name[i] >= 'a' ? 0x145 + name[i] - 'a' : 0x12B + name[i] - 'A';
+    sChallenger.name[i++] = 0xFFFF;
+    for (; i < 8; i++) sChallenger.name[i] = 0;
+    sChallenger.iv = sTierIv[tier];
+    sChallenger.ai = sCanvasTierAI[tier];
+    n = BuildTeam(tier, 0xFF, level, partySize);
+    sChallenger.count = n ? n : 1;
+    sChallenger.prizeRate = repeat ? GUEST_PRIZE_RATE : GUEST_PRIZE_RATE * 2;
+    sChallenger.kind = CANVAS_CHALLENGER_GUEST;
+    sChallenger.valid = TRUE;
+    return cls;
+}
+
+// GymChallenge_GenerateOakFinale: Oak's set team (the GBA's sOakFinaleTeam) a level above the player's average, 65
+// at least, every stat's IV at its best; a double battle (the porter's trainer), the hardest AI, his own prize
+static const struct {
+    u16 species, item;
+    u8 nature, evs;          // (evs: 0 physical and fast, 1 special and fast, 2 bulky)
+    u16 moves[4];
+} sOakTeam[] = {
+    {SPECIES_TAUROS, ITEM_CHOICE_BAND, NATURE_JOLLY, 0, {MOVE_DOUBLE_EDGE, MOVE_EARTHQUAKE, MOVE_ROCK_SLIDE, MOVE_ZEN_HEADBUTT}},
+    {SPECIES_EXEGGUTOR, ITEM_SITRUS_BERRY, NATURE_MODEST, 1, {MOVE_PSYCHIC, MOVE_GIGA_DRAIN, MOVE_SLEEP_POWDER, MOVE_EXPLOSION}},
+    {SPECIES_ARCANINE, ITEM_LEFTOVERS, NATURE_ADAMANT, 0, {MOVE_FLARE_BLITZ, MOVE_EXTREME_SPEED, MOVE_CRUNCH, MOVE_WILL_O_WISP}},
+    {SPECIES_GYARADOS, ITEM_LUM_BERRY, NATURE_JOLLY, 0, {MOVE_DRAGON_DANCE, MOVE_WATERFALL, MOVE_EARTHQUAKE, MOVE_ICE_FANG}},
+    {SPECIES_SNORLAX, ITEM_LEFTOVERS, NATURE_CAREFUL, 2, {MOVE_BODY_SLAM, MOVE_CURSE, MOVE_REST, MOVE_EARTHQUAKE}},
+    {SPECIES_DRAGONITE, ITEM_LUM_BERRY, NATURE_ADAMANT, 0, {MOVE_DRAGON_DANCE, MOVE_OUTRAGE, MOVE_EXTREME_SPEED, MOVE_EARTHQUAKE}},
+};
+// (HeartGold's order: HP, Attack, Defense, Speed, Sp. Atk, Sp. Def)
+static const u8 sOakEvs[3][6] = {{4, 252, 0, 252, 0, 0}, {4, 0, 0, 252, 252, 0}, {252, 4, 252, 0, 0, 0}};
+static const u16 sOakName[] = {0x139, 0x145, 0x14F, 0xFFFF};     // (Oak)
+
+static void Canvas_OakFinale(void)
+{
+    s32 level = Canvas_PlayerAverageLevel() + 1;
+    u32 i;
+    if (level < 65) level = 65;
+    if (level > 100) level = 100;
+    sChallenger.trainerClass = TRAINERCLASS_ELDER;
+    for (i = 0; i < 8; i++) sChallenger.name[i] = i < NELEMS(sOakName) ? sOakName[i] : 0;
+    for (i = 0; i < NELEMS(sOakTeam); i++) {
+        sChallenger.species[i] = sOakTeam[i].species;
+        sChallenger.item[i] = sOakTeam[i].item;
+        sChallenger.level[i] = level;
+    }
+    sChallenger.count = NELEMS(sOakTeam);
+    sChallenger.iv = 31;
+    sChallenger.ai = sCanvasTierAI[PRACTICE_TIERS - 1];
+    sChallenger.prizeRate = CANVAS_PRIZE_KEEP;
+    sChallenger.kind = CANVAS_CHALLENGER_OAK;
+    sChallenger.valid = TRUE;
+}
+
+// ---------------------------------------------------------------- challengers at the player's gym
+// GymChallenge_Generate (the GBA's GenerateTrainer): a random class and name, four to six strong Pokemon of any type
+// at the player's average level, good IVs, often an item; no prize from HeartGold (the script pays the streak's).
+// -> VAR_RESULT the class (its look, its name's slot), 0x8005 the name (female ones from 64)
+static void Canvas_GenerateGymTrainer(void)
+{
+    u32 cls = Rand(NELEMS(sCanvasClasses)), i, nameIdx, n;
+    BOOL female = sCanvasClasses[cls].female;
+    const u8 *name;
+    nameIdx = female ? Rand(NELEMS(sCanvasFemaleNames)) : Rand(NELEMS(sCanvasMaleNames));
+    name = female ? sCanvasFemaleNames[nameIdx] : sCanvasMaleNames[nameIdx];
+    sChallenger.trainerClass = sCanvasClasses[cls].trainerClass;
+    for (i = 0; i < 7 && name[i]; i++)
+        sChallenger.name[i] = name[i] >= 'a' ? 0x145 + name[i] - 'a' : 0x12B + name[i] - 'A';
+    sChallenger.name[i++] = 0xFFFF;
+    for (; i < 8; i++) sChallenger.name[i] = 0;
+    n = BuildTeam(PRACTICE_TIERS - 1, 0xFF, Canvas_PlayerAverageLevel(), 4 + Rand(3));
+    for (i = 0; i < n; i++)          // (40 in 100 hold something: the GBA's)
+        sChallenger.item[i] = Rand(100) < 40 ? sCanvasHeldItems[Rand(NELEMS(sCanvasHeldItems))] : 0;
+    sChallenger.count = n ? n : 1;
+    sChallenger.iv = 24;
+    sChallenger.ai = sCanvasTierAI[PRACTICE_TIERS - 1];
+    sChallenger.prizeRate = 0;
+    sChallenger.kind = CANVAS_CHALLENGER_TRAINER;
+    sChallenger.valid = TRUE;
+    SetScriptVar(VAR_RESULT, cls);
+    SetScriptVar(0x8005, nameIdx + (female ? 64 : 0));
+}
+
+// A famous trainer (the GBA's GenerateFamous / GenerateBoss): their own team from the trainer data, moved so its
+// average level is the player's (+ plus); the hardest AI; no prize from HeartGold
+static void Canvas_PrepareFamous(u16 trainerId, u32 teamAverage, u32 plus)
+{
+    sChallenger.famousId = trainerId;
+    sChallenger.levelShift = (s32)Canvas_PlayerAverageLevel() + (s32)plus - (s32)teamAverage;
+    sChallenger.prizeRate = 0;
+    sChallenger.kind = CANVAS_CHALLENGER_FAMOUS;
+    sChallenger.valid = TRUE;
+}
