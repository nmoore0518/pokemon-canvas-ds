diff --git a/src/canvas_flags.c b/src/canvas_flags.c
new file mode 100644
index 00000000..603df0a7
--- /dev/null
+++ b/src/canvas_flags.c
@@ -0,0 +1,36 @@
+// Pokemon Canvas: our own flags and vars, routed through HeartGold's own flag/var functions so every script
+// command, object visibility flag and map-script condition works with them unchanged.
+//   flags 0x2000..0x2FFF -> SAVE_MISC_DATA.canvasFlags      (HeartGold's own: 0..2911; temp flags 0x4000+)
+//   vars  0x5000..0x51FF -> SAVE_MISC_DATA.canvasVars       (HeartGold's own: 0x4000..0x416F)
+// Hooks Save_VarsFlags_GetFlagAddr (0205045C) and Save_VarsFlags_GetVarAddr (020504A4).
+#include "../include/types.h"
+#include "../include/save.h"
+
+#define CANVAS_FLAG_BASE 0x2000
+#define CANVAS_VAR_BASE  0x5000
+#define TEMP_FLAG_BASE   0x4000
+#define VAR_BASE         0x4000
+#define TEMP_FLAGS_RAM   ((u8 *)0x021D4170)   // sTempFlags
+
+struct VarsFlagsLayout {
+    u16 vars[0x170];
+    u8 flags[2912 / 8];
+};
+
+u8 *Canvas_GetFlagAddr(struct VarsFlagsLayout *varsFlags, u16 flagId)
+{
+    if (flagId == 0)
+        return NULL;
+    if (flagId >= CANVAS_FLAG_BASE && flagId < CANVAS_FLAG_BASE + CANVAS_NUM_FLAGS)
+        return &Sav2_Misc_get(SaveBlock2_get())->canvasFlags[(flagId - CANVAS_FLAG_BASE) / 8];
+    if (flagId < TEMP_FLAG_BASE)
+        return &varsFlags->flags[flagId / 8];
+    return &TEMP_FLAGS_RAM[(flagId - TEMP_FLAG_BASE) / 8];
+}
+
+u16 *Canvas_GetVarAddr(struct VarsFlagsLayout *varsFlags, u16 varId)
+{
+    if (varId >= CANVAS_VAR_BASE && varId < CANVAS_VAR_BASE + CANVAS_NUM_VARS)
+        return &Sav2_Misc_get(SaveBlock2_get())->canvasVars[varId - CANVAS_VAR_BASE];
+    return &varsFlags->vars[varId - VAR_BASE];
+}
diff --git a/src/canvas_map_headers.c b/src/canvas_map_headers.c
new file mode 100644
index 00000000..f846b04d
--- /dev/null
+++ b/src/canvas_map_headers.c
@@ -0,0 +1,53 @@
+// Pokemon Canvas: maps past HeartGold's 540.
+// HeartGold's map header table sits in the ARM9 and can't grow (hg-engine needs the ARM9 laid out as retail), so
+// headers for our maps live in a/0/2/8 (CODE_ADDON_CANVAS_MAP_HEADERS: u32 count, u32 first id, 24 bytes a map).
+// Every MapHeader_Get... calls MapNumberBoundsCheck(mapId) and then reads sMapHeaders[result]; this replaces it,
+// and for one of our maps copies its header into a spare entry of HeartGold's table (MAP_UNUSED) and returns that.
+#include "../include/types.h"
+#include "../include/constants/file.h"
+
+#define RETAIL_MAP_COUNT   540
+#define MAP_NOTHING        1
+#define MAP_HEADER_WINDOW  538          // MAP_UNUSED: never used by HeartGold, kept free by the canvas tools
+#define MAP_HEADER_SIZE    24
+#define MAP_HEADERS_RAM    ((u8 *)0x020F6BE0)   // sMapHeaders
+#define CACHE_SIZE         8
+
+static u16 sCacheId[CACHE_SIZE];
+static u8 sCache[CACHE_SIZE][MAP_HEADER_SIZE];
+static u8 sCacheNext;
+static u32 sTableInfo[2];   // count, first id
+static u32 sReady;          // (this overlay's memory isn't cleared at load: set up on first use)
+#define READY_MAGIC 0x43564D48
+
+u32 Canvas_MapNumberBoundsCheck(u32 mapId)
+{
+    u8 *window = MAP_HEADERS_RAM + MAP_HEADER_WINDOW * MAP_HEADER_SIZE;
+    int i, j;
+    if (mapId < RETAIL_MAP_COUNT)
+        return mapId;
+    if (sReady != READY_MAGIC)
+    {
+        for (i = 0; i < CACHE_SIZE; i++)
+            sCacheId[i] = 0xFFFF;
+        sCacheNext = 0;
+        ReadFromNarcMemberByIdPair(sTableInfo, ARC_CODE_ADDONS, CODE_ADDON_CANVAS_MAP_HEADERS, 0, 8);
+        sReady = READY_MAGIC;
+    }
+    for (i = 0; i < CACHE_SIZE; i++)
+    {
+        if (sCacheId[i] == mapId)
+            goto found;
+    }
+    if (mapId - sTableInfo[1] >= sTableInfo[0])
+        return MAP_NOTHING;
+    i = sCacheNext;
+    sCacheNext = (sCacheNext + 1) % CACHE_SIZE;
+    ReadFromNarcMemberByIdPair(sCache[i], ARC_CODE_ADDONS, CODE_ADDON_CANVAS_MAP_HEADERS,
+                               8 + (mapId - sTableInfo[1]) * MAP_HEADER_SIZE, MAP_HEADER_SIZE);
+    sCacheId[i] = mapId;
+found:
+    for (j = 0; j < MAP_HEADER_SIZE; j++)
+        window[j] = sCache[i][j];
+    return MAP_HEADER_WINDOW;
+}
